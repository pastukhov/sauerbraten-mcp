+static cJSON *deformation(const std::string &method, const cJSON *p) {
+  bool vertex = method == "geometry_vertex_set";
+  if (!fields(p, vertex ? "|request_id||map_epoch||expected_revision||selection||corner||position|"
+                        : "|request_id||map_epoch||expected_revision||selection||depths|"))
+    return error("INVALID_ARGUMENT", "unknown deformation fields");
+  selinfo s;
+  if (!integer_tokens(get(p, "selection")) || !selection(get(p, "selection"), s))
+    return error("INVALID_ARGUMENT", "invalid aligned selection or cell budget exceeded");
+  int coordinates[4], position[3];
+  if (vertex) {
+    if (!integer_tokens(get(p, "corner")) || !integer_tokens(get(p, "position")) ||
+        !ints3(get(p, "corner"), coordinates, 0, 1) || !ints3(get(p, "position"), position, 0, 8))
+      return error("INVALID_ARGUMENT", "corner must be three bits; position must be three integers 0..8");
+  } else {
+    const cJSON *depths = get(p, "depths");
+    if (!cJSON_IsArray(depths) || cJSON_GetArraySize(depths) != 4)
+      return error("INVALID_ARGUMENT", "four integer face depths required");
+    for (int i = 0; i < 4; i++)
+      if (!strict_integer(cJSON_GetArrayItem(depths, i), 0, 8, coordinates[i]))
+        return error("INVALID_ARGUMENT", "face depths must be integers 0..8");
+  }
+  const char *err = mcp_deform(s, vertex, coordinates, position);
+  return err ? error(err, "deformation was not applied") : mutation_result(p);
+}
