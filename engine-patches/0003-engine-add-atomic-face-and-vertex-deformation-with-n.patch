+// cJSON reserves bits 8/9 for ownership; this application bit retains lexical
+// number kind without changing vendored cJSON or its numeric type predicate.
+static const int float_literal = 1 << 16;
+bool strict_integer(const cJSON *v, int lo, int hi, int &out) {
+  return v && !(v->type & float_literal) && integer(v, lo, hi, out);
+}
+bool integer_tokens(const cJSON *v) {
+  if (!v || (v->type & float_literal)) return false;
+  for (const cJSON *c = v->child; c; c = c->next)
+    if (!integer_tokens(c)) return false;
+  return true;
+}
