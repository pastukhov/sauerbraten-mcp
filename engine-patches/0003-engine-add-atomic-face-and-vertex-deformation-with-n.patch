+// Unlike isvalidcube(), this must not depend on cached visibility or neighbors.
+static bool mcp_valid_shape(cube &c)
+{
+  loopi(12) if(edgeget(c.edges[i],0)>edgeget(c.edges[i],1) || edgeget(c.edges[i],1)>8) return false;
+  ivec vertices[8];
+  loopi(8) getcubevector(c,2,i&1,(i>>1)&1,(i>>2)&1,vertices[i]);
+  bool volume=false;
+  for(int a=1;a<8 && !volume;a++) for(int b=a+1;b<8 && !volume;b++) for(int d=b+1;d<8;d++)
+  {
+    ivec n; n.cross(ivec(vertices[a]).sub(vertices[0]),ivec(vertices[b]).sub(vertices[0]));
+    if(n.dot(ivec(vertices[d]).sub(vertices[0]))) { volume=true; break; }
+  }
+  if(!volume) return false;
+  loopi(6)
+  {
+    ivec face[4];genfaceverts(c,i,face);
+    int order=faceconvexity(face)<0 ? 1 : 0;
+    loopj(2)
+    {
+      const ivec &a=face[order], &b=face[(order+j+1)&3], &d=face[(order+j+2)&3];
+      ivec n;n.cross(ivec(b).sub(a),ivec(d).sub(a));
+      if(n.iszero()) continue;
+      loopk(8) if(n.dot(ivec(vertices[k]).sub(a))>0) return false;
+    }
+  }
+  return true;
+}
+const char *mcp_deform(selinfo &s,bool vertex,const int *coordinates,const int *position)
+{
+  struct Candidate { cube *target; cube shape; };
+  std::vector<Candidate> candidates;
+  bool different=false;
+  for(int z=0;z<s.s.z;z++) for(int y=0;y<s.s.y;y++) for(int x=0;x<s.s.x;x++)
+  {
+    ivec origin=ivec(x,y,z).mul(s.grid).add(s.o), found;int size;
+    cube &c=lookupcube(origin,-s.grid,found,size);
+    if(size!=s.grid || c.children) return "GEOMETRY_RESOLUTION_MISMATCH";
+    if(isempty(c)) return "INVALID_GEOMETRY";
+    Candidate next;next.target=&c;next.shape=c;
+    if(vertex)
+    {
+      loopi(3) edgeset(cubeedge(next.shape,i,coordinates[R[i]],coordinates[C[i]]),coordinates[i],position[i]);
+    }
+    else
+    {
+      int d=dimension(s.orient),end=dimcoord(s.orient);
+      loopi(4) edgeset(next.shape.edges[4*d+i],end,coordinates[i]);
+    }
+    if(!mcp_valid_shape(next.shape)) return "INVALID_GEOMETRY";
+    different=different || memcmp(c.edges,next.shape.edges,12)!=0;
+    candidates.push_back(next);
+  }
+  if(!different) return NULL;
+  size_t bytes;if(!mcp_selection_cost(s,bytes)) return "UNDO_UNAVAILABLE";
+  undoblock *snapshot=newundocube(s);if(!snapshot) return "UNDO_UNAVAILABLE";
+  if(undosize(snapshot)>(undomegs<<20)) { freeundo(snapshot); return "UNDO_UNAVAILABLE"; }
+  // All candidates and the inverse are ready before touching the live world.
+  mcp::begin_mutation();forcenextundo();mcp_force_entity_boundary();
+  for(size_t i=0;i<candidates.size();i++) memcpy(candidates[i].target->edges,candidates[i].shape.edges,12);
+  changed(s);mcp_record(snapshot);forcenextundo();mcp_force_entity_boundary();mcp::end_mutation();
+  return NULL;
+}
 static const char *mcp_swapundo(undolist &a,undolist &b,bool rpc)
 {
   if(!editmode) return "NOT_EDITING";
