--- /dev/null
+++ b/src/engine/mcpstate.cpp
@@ -0,0 +1,154 @@
+#include "mcpstate.h"
+#include <algorithm>
+#include <stdio.h>
+#include <stdlib.h>
+#include <sys/random.h>
+namespace mcp {
+bool config_failed = false, shader_config_unsupported = false, shader_registry_unsupported = false;
+void note_shader_definition() {
+  // Shader registry survives reset; replay cannot prove custom GLSL equivalence.
+  shader_registry_unsupported = true;
+  config_supported = false;
+  if (loading)
+    shader_config_unsupported = true;
+  note_resource();
+}
+int config_depth = 0;
+void note_config_change() {
+  if (tracking && !loading) {
+    config_supported = false;
+    note_change();
+  }
+}
+uint64_t revision = 0, view_revision = 1, vslot_generation = 1, mapmodel_generation = 1;
+bool dirty = false, lighting_dirty = true, config_supported = true, recovery_required = false,
+     tracking = false, loading = false, context_dependent = false;
+std::string session_id, map_epoch, source_config, recovery_reference;
+std::vector<std::string> config_files;
+static std::vector<uint64_t> entity_generations(10000, 1);
+static int mutation_depth = 0;
+static bool pending = false;
+std::string decimal(uint64_t n) {
+  char s[32];
+  snprintf(s, sizeof(s), "%llu", (unsigned long long)n);
+  return s;
+}
+std::string uuid() {
+  unsigned char b[16];
+  size_t done = 0;
+  while (done < sizeof(b)) {
+    ssize_t n = getrandom(b + done, sizeof(b) - done, 0);
+    if (n <= 0)
+      abort();
+    done += n;
+  }
+  b[6] = (b[6] & 15) | 64;
+  b[8] = (b[8] & 63) | 128;
+  char s[37];
+  snprintf(s, sizeof(s), "%02x%02x%02x%02x-%02x%02x-%02x%02x-%02x%02x-%02x%02x%02x%02x%02x%02x",
+           b[0], b[1], b[2], b[3], b[4], b[5], b[6], b[7], b[8], b[9], b[10], b[11], b[12], b[13],
+           b[14], b[15]);
+  return s;
+}
+int allocation_after = -1;
+bool allocation_allowed() {
+  if (allocation_after < 0)
+    return true;
+  if (!allocation_after)
+    return false;
+  --allocation_after;
+  return true;
+}
+void state_init() {
+  session_id = uuid();
+  map_epoch = uuid();
+  revision = 1;
+  tracking = true;
+  loading = false;
+}
+void note_change(bool content, bool lighting) {
+  if (!tracking)
+    return;
+  if (mutation_depth)
+    pending = true;
+  else
+    revision++;
+  if (content)
+    dirty = true;
+  if (lighting)
+    lighting_dirty = true;
+}
+void note_reset() {
+  config_files.clear();
+  source_config.clear();
+  loading = true;
+  config_failed = false;
+  shader_config_unsupported = false;
+  config_depth = 0;
+  context_dependent = false;
+  vslot_generation++;
+  mapmodel_generation++;
+  std::fill(entity_generations.begin(), entity_generations.end(), 1);
+  if (!tracking)
+    return;
+  map_epoch = uuid();
+  revision++;
+  view_revision++;
+  dirty = true;
+  recovery_required = false;
+  config_supported = !shader_registry_unsupported;
+}
+void note_loaded(const char *config, bool lm, const char *logical) {
+  recovery_reference = logical;
+  source_config = config ? config : "";
+  loading = false;
+  config_supported = !context_dependent && !shader_registry_unsupported;
+  dirty = false;
+  lighting_dirty = !lm;
+  if (tracking)
+    note_change(false, false);
+}
+void note_created() {
+  source_config = "";
+  loading = false;
+  config_supported = !context_dependent && !config_failed && !shader_registry_unsupported;
+  dirty = true;
+  lighting_dirty = true;
+  note_change();
+}
+void note_resource(bool model, bool definition) {
+  if (model)
+    mapmodel_generation++;
+  else
+    vslot_generation++;
+  if (tracking && !loading) {
+    if (definition)
+      config_supported = false;
+    note_change(definition, definition);
+  }
+}
+void note_entity(int n) {
+  if (n >= 0 && n < 10000)
+    entity_generations[n]++;
+  note_change();
+}
+uint64_t entity_generation(int n) { return n >= 0 && n < 10000 ? entity_generations[n] : 0; }
+void note_config_file(const char *name) {
+  if (loading && std::find(config_files.begin(), config_files.end(), name) == config_files.end())
+    config_files.push_back(name);
+}
+void begin_mutation() { mutation_depth++; }
+void end_mutation() {
+  if (mutation_depth > 0 && !--mutation_depth && pending) {
+    revision++;
+    pending = false;
+  }
+}
+cJSON *token_json() {
+  cJSON *o = cJSON_CreateObject();
+  cJSON_AddStringToObject(o, "session_id", session_id.c_str());
+  cJSON_AddStringToObject(o, "map_epoch", map_epoch.c_str());
+  cJSON_AddStringToObject(o, "revision", decimal(revision).c_str());
+  return o;
+}
+} // namespace mcp
