+// Run only via the explicit local --mcp-test-case CLI after full SDL/GL init.
+#include "engine.h"
+#include "mcpeditor.h"
+#include "mcpnative.h"
+#include "mcpstate.h"
+#include "mcpvalidate.h"
+extern selinfo sel;
+extern bool havesel;
+extern int enthover, entediting, efocus;
+namespace game {
+extern vector<uchar> messages;
+extern bool connected;
+} // namespace game
+extern void clearundos();
+extern void fillblendmap(int, int, int, int, uchar);
+extern int mcp_history_records(bool redo);
+extern bool mcp_history_accounting_valid();
+extern void mcp_prune_oldest_step_for_test();
+#define CHECK(x)                                                                                   \
+  do {                                                                                             \
+    if (!(x)) {                                                                                    \
+      cJSON_AddStringToObject(report, "failure", #x);                                              \
+      return false;                                                                                \
+    }                                                                                              \
+  } while (0)
+static selinfo at(int x = 16, int y = 16, int z = 16) {
+  selinfo s;
+  s.o = ivec(x, y, z);
+  s.s = ivec(1, 1, 1);
+  s.grid = 8;
+  s.orient = 5;
+  s.cxs = s.cys = 2;
+  return s;
+}
+static cJSON *read_request() {
+  return cJSON_Parse("{\"method\":\"region_read\",\"params\":{\"bounds\":{\"origin\":[0,0,0],"
+                     "\"extent\":[64,64,64]}}}");
+}
+bool mcp_run_native_case(const std::string &name, cJSON *report) {
+  if (name == "boot")
+    return true;
+  execute("newmap 10");
+  editmode = true;
+  entediting = 1;
+  setvar("editinview", 0);
+  clearundos();
+  sel = at();
+  havesel = true;
+  forcenextundo();
+  if (name == "rpc_view_state") {
+    entity e;
+    memset(&e, 0, sizeof(e));
+    e.o = vec(64, 64, 600);
+    e.type = ET_LIGHT;
+    e.attr1 = 100;
+    int index = -1;
+    CHECK(!mcp_entity(index, e, true));
+    efocus = -1;
+    lu = ivec(64, 64, 64);
+    lusize = 64;
+    cJSON *q = read_request();
+    cJSON *r = mcp::dispatch(q);
+    CHECK(cJSON_IsTrue(mcp::get(r, "ok")));
+    cJSON_Delete(q);
+    cJSON_Delete(r);
+    CHECK(lu == ivec(64, 64, 64) && lusize == 64);
+    q = cJSON_CreateObject();
+    cJSON_AddStringToObject(q, "method", "history_undo");
+    cJSON *params = cJSON_AddObjectToObject(q, "params");
+    cJSON_AddStringToObject(params, "request_id", mcp::uuid().c_str());
+    cJSON_AddStringToObject(params, "map_epoch", mcp::map_epoch.c_str());
+    cJSON_AddStringToObject(params, "expected_revision", mcp::decimal(mcp::revision).c_str());
+    r = mcp::dispatch(q);
+    CHECK(cJSON_IsTrue(mcp::get(r, "ok")));
+    cJSON_Delete(q);
+    cJSON_Delete(r);
+    CHECK(efocus == -1);
+    CHECK(lu == ivec(64, 64, 64) && lusize == 64);
+    return true;
+  }
+  if (name == "capture_error") {
+    ImageData image(screenw, screenh, 3);
+    memset(image.data, 0xA5, image.pitch * image.h);
+    GLuint pbo = 0;
+    glGenBuffers_(1, &pbo);
+    glBindBuffer_(GL_PIXEL_PACK_BUFFER, pbo);
+    glBufferData_(GL_PIXEL_PACK_BUFFER, 1, NULL, GL_STATIC_DRAW);
+    bool captured = mcp::capture_pixels(image);
+    glBindBuffer_(GL_PIXEL_PACK_BUFFER, 0);
+    glDeleteBuffers_(1, &pbo);
+    CHECK(!captured);
+    CHECK(image.data[0] == 0 && image.data[image.pitch * image.h - 1] == 0);
+    return true;
+  }
+  if (name == "exact_faces") {
+    cube &c = lookupcube(sel.o, sel.grid);
+    bool found = false;
+    int face = 0;
+    for (int a = 0; a < 12 && !found; a++)
+      for (int b = a + 1; b < 12 && !found; b++) {
+        cube trial = c;
+        solidfaces(trial);
+        trial.edges[a] = 0;
+        trial.edges[b] = 0;
+        if (!isvalidcube(trial))
+          continue;
+        for (int f = 0; f < 6; f++)
+          if (visibleorient(trial, f) != f) {
+            memcpy(c.edges, trial.edges, 12);
+            face = f;
+            found = true;
+            break;
+          }
+      }
+    CHECK(found);
+    ushort before[6];
+    memcpy(before, c.texture, sizeof(before));
+    CHECK(!mcp_geometry(sel, 2, 2, face, 0));
+    for (int f = 0; f < 6; f++)
+      CHECK(c.texture[f] == (f == face ? 2 : before[f]));
+    return true;
+  }
+  if (name == "undo_interleave" || name == "read_boundaries") {
+    mpdelcube(sel, true);
+    CHECK(mcp_history_records(false) == 1);
+    if (name == "read_boundaries") {
+      cJSON *q = read_request();
+      cJSON *r = mcp::dispatch(q);
+      CHECK(cJSON_IsTrue(mcp::get(r, "ok")));
+      cJSON_Delete(q);
+      cJSON_Delete(r);
+      mpedittex(2, 1, sel, true);
+      CHECK(mcp_history_records(false) == 1);
+      return true;
+    }
+    CHECK(!mcp_geometry(sel, 0, 1, -1, 0));
+    mpdelcube(sel, true);
+    CHECK(mcp_history_records(false) == 3);
+    CHECK(!mcp_history(false));
+    CHECK(isentirelysolid(lookupcube(sel.o, -sel.grid)));
+    CHECK(!mcp_history(false));
+    CHECK(isempty(lookupcube(sel.o, -sel.grid)));
+    CHECK(!mcp_history(false));
+    CHECK(isentirelysolid(lookupcube(sel.o, -sel.grid)));
+    return true;
+  }
+  if (name == "entity_boundary_selected" || name == "entity_boundary_hover") {
+    entity e;
+    memset(&e, 0, sizeof(e));
+    e.o = vec(64, 64, 600);
+    e.type = ET_LIGHT;
+    e.attr1 = 100;
+    e.attr2 = 255;
+    int index = -1;
+    CHECK(!mcp_entity(index, e, true));
+    clearundos();
+    entgroup.shrink(0);
+    if (name == "entity_boundary_hover")
+      enthover = index;
+    else
+      entgroup.add(index);
+    execute("entset light 200 255 0 0 0");
+    CHECK(entities::getents()[index]->attr1 == 200);
+    CHECK(!mcp_geometry(sel, 1, 1, -1, 0));
+    execute("entset light 300 255 0 0 0");
+    CHECK(entities::getents()[index]->attr1 == 300);
+    CHECK(mcp_history_records(false) == 3);
+    CHECK(!mcp_history(false));
+    CHECK(entities::getents()[index]->attr1 == 200);
+    CHECK(!mcp_history(false));
+    CHECK(!mcp_history(false));
+    CHECK(entities::getents()[index]->attr1 == 100);
+    return true;
+  }
+  if (name == "attached_history") {
+    mpeditent(0, vec(64, 64, 600), ET_LIGHT, 100, 255, 255, 255, 0, false);
+    mpeditent(1, vec(64, 64, 604), ET_SPOTLIGHT, 45, 0, 0, 0, 0, false);
+    attachentities();
+    CHECK(entities::getents()[0]->attached);
+    entgroup.shrink(0);
+    entgroup.add(0);
+    enthover = -1;
+    mcp_force_entity_boundary();
+    execute("delent");
+    CHECK(entities::getents()[0]->type == ET_EMPTY);
+    CHECK(!entities::getents()[1]->attached);
+    int count = mcp_history_records(false);
+    const char *err = mcp_history(false);
+    CHECK(err && !strcmp(err, "ATTACHED_ENTITY_UNSUPPORTED"));
+    CHECK(mcp_history_records(false) == count);
+    return true;
+  }
+  if (name == "history_accounting" || name == "allocation_failure") {
+    mpdelcube(sel, true);
+    sel = at(32);
+    mpdelcube(sel, true);
+    CHECK(mcp_history_records(false) == 2);
+    CHECK(mcp_history_accounting_valid());
+    if (name == "allocation_failure") {
+      int count = mcp_history_records(false);
+      mcp::allocation_after = 1;
+      CHECK(mcp_history(false));
+      mcp::allocation_after = -1;
+      CHECK(mcp_history_records(false) == count);
+      CHECK(!mcp_history_records(true));
+      CHECK(mcp_history_accounting_valid());
+      mcp::allocation_after = 0;
+      CHECK(mcp_geometry(sel, 0, 1, -1, 0));
+      mcp::allocation_after = -1;
+      CHECK(mcp_history_records(false) == count);
+      return true;
+    }
+    CHECK(!mcp_history(false));
+    CHECK(mcp_history_accounting_valid());
+    CHECK(!mcp_history(true));
+    CHECK(mcp_history_accounting_valid());
+    CHECK(!mcp_geometry(sel, 0, 1, -1, 0));
+    CHECK(mcp_history_records(false) == 3);
+    mcp_prune_oldest_step_for_test();
+    CHECK(mcp_history_records(false) == 1);
+    CHECK(mcp_history_accounting_valid());
+    return true;
+  }
+  if (name == "aux_fingerprint") {
+    cJSON *before = mcp::fingerprint();
+    std::string digest = mcp::str(before, "content_digest");
+    cJSON_Delete(before);
+    fillblendmap(0, 0, 16, 16, 0);
+    cJSON *after = mcp::fingerprint();
+    std::string changed = mcp::str(after, "content_digest");
+    cJSON_Delete(after);
+    CHECK(digest != changed);
+    return true;
+  }
+  if (name == "remote_native_history") {
+    sel = at();
+    sel.s = ivec(20, 20, 20);
+    sel.cxs = sel.cys = 40;
+    forcenextundo();
+    mpdelcube(sel, true);
+    CHECK(mcp_history_records(false) == 1);
+    extern ENetPeer *curpeer;
+    extern void editundo();
+    ENetPeer fake;
+    memset(&fake, 0, sizeof(fake));
+    ENetPeer *before = curpeer;
+    curpeer = &fake;
+    editundo();
+    curpeer = before;
+    CHECK(mcp_history_records(false) == 1);
+    clearundos();
+    sel = at(512);
+    forcenextundo();
+    mpdelcube(sel, true);
+    CHECK(mcp_history_records(false) == 1);
+    bool wasconnected = game::connected;
+    game::connected = true;
+    before = curpeer;
+    curpeer = &fake;
+    int queued = game::messages.length();
+    editundo();
+    curpeer = before;
+    game::connected = wasconnected;
+    CHECK(mcp_history_records(false) == 0);
+    CHECK(game::messages.length() > queued);
+    return true;
+  }
+  if (name == "config_edits") {
+    cJSON *before = mcp::fingerprint();
+    std::string digest = mcp::str(before, "config_digest");
+    cJSON_Delete(before);
+    mcp::dirty = false;
+    mcp::config_supported = true;
+    uint64_t revision = mcp::revision;
+    execute("autograss textures/default.png");
+    CHECK(mcp::revision > revision && mcp::dirty && !mcp::config_supported);
+    cJSON *after = mcp::fingerprint();
+    CHECK(mcp::str(after, "config_digest") != digest);
+    cJSON_Delete(after);
+    const char *commands[] = {"mapsound test/none 100 1", "altmapsound test/two 100",
+                              "mapsoundreset"};
+    for (int i = 0; i < 3; i++) {
+      mcp::dirty = false;
+      mcp::config_supported = true;
+      revision = mcp::revision;
+      execute(commands[i]);
+      CHECK(mcp::revision > revision && mcp::dirty && !mcp::config_supported);
+    }
+    extern MSlot materialslots[(MATF_VOLUME | MATF_INDEX) + 1];
+    before = mcp::fingerprint();
+    digest = mcp::str(before, "config_digest");
+    cJSON_Delete(before);
+    materialslots[MAT_WATER].scale = 2;
+    after = mcp::fingerprint();
+    CHECK(mcp::str(after, "config_digest") != digest);
+    cJSON_Delete(after);
+    before = mcp::fingerprint();
+    digest = mcp::str(before, "config_digest");
+    cJSON_Delete(before);
+    DELETEA(slots.last()->layermaskname);
+    slots.last()->layermaskname = newstring("textures/default.png");
+    slots.last()->layermaskscale = 2;
+    after = mcp::fingerprint();
+    CHECK(mcp::str(after, "config_digest") != digest);
+    cJSON_Delete(after);
+    return true;
+  }
+  if (name == "shader_registry") {
+    const char *red =
+        "shader 0 mcp_registry [attribute vec4 vvertex; uniform mat4 camprojmatrix; void main(){ "
+        "gl_Position = camprojmatrix * vvertex; }] [void main(){ gl_FragColor = vec4(1,0,0,1); }]";
+    const char *blue =
+        "shader 0 mcp_registry [attribute vec4 vvertex; uniform mat4 camprojmatrix; void main(){ "
+        "gl_Position = camprojmatrix * vvertex; }] [void main(){ gl_FragColor = vec4(0,0,1,1); }]";
+    mcp::note_reset();
+    mcp::tracking = false;
+    execute(red);
+    mcp::tracking = true;
+    CHECK(mcp::shader_config_unsupported);
+    mcp::note_loaded("", false);
+    CHECK(!mcp::config_supported);
+    mcp::note_reset();
+    CHECK(!mcp::shader_config_unsupported && mcp::shader_registry_unsupported);
+    execute(blue);
+    CHECK(mcp::shader_config_unsupported);
+    mcp::note_loaded("", false);
+    CHECK(!mcp::config_supported);
+    mcp::note_reset();
+    execute("setshader mcp_registry");
+    CHECK(mcp::shader_config_unsupported);
+    mcp::note_loaded("", false);
+    CHECK(!mcp::config_supported);
+    execute("altshader stdworld mcp_registry");
+    execute("newmap 10");
+    CHECK(!mcp::config_supported && mcp::shader_registry_unsupported);
+    editmode = true;
+    std::string epoch = mcp::map_epoch;
+    const char *methods[] = {"map_new", "commit_open", "save_staged_map"};
+    for (int i = 0; i < 3; i++) {
+      cJSON *q = cJSON_CreateObject();
+      cJSON_AddStringToObject(q, "method", methods[i]);
+      cJSON *p = cJSON_AddObjectToObject(q, "params");
+      cJSON_AddStringToObject(p, "request_id", mcp::uuid().c_str());
+      cJSON_AddStringToObject(p, "map_epoch", mcp::map_epoch.c_str());
+      cJSON_AddStringToObject(p, "expected_revision", mcp::decimal(mcp::revision).c_str());
+      cJSON *r = mcp::dispatch(q);
+      CHECK(mcp::str(mcp::get(r, "error"), "code") == "UNSUPPORTED_CONFIG");
+      cJSON_Delete(q);
+      cJSON_Delete(r);
+      CHECK(mcp::map_epoch == epoch);
+    }
+    return true;
+  }
+  if (name == "camera_modes") {
+    extern int thirdperson, zoom;
+    execute("thirdperson 1; zoominvel 0; zoom 1");
+    recomputecamera();
+    mcp::observe_view();
+    cJSON *request = cJSON_CreateObject();
+    cJSON_AddStringToObject(request, "method", "camera_set");
+    cJSON *p = cJSON_AddObjectToObject(request, "params");
+    cJSON_AddStringToObject(p, "request_id", mcp::uuid().c_str());
+    cJSON_AddStringToObject(p, "map_epoch", mcp::map_epoch.c_str());
+    cJSON_AddStringToObject(p, "expected_revision", mcp::decimal(mcp::revision).c_str());
+    int position[] = {100, 100, 600};
+    cJSON_AddItemToObject(p, "position", cJSON_CreateIntArray(position, 3));
+    cJSON_AddNumberToObject(p, "yaw", 45);
+    cJSON_AddNumberToObject(p, "pitch", -20);
+    cJSON_AddNumberToObject(p, "fov", 90);
+    cJSON *reply = mcp::dispatch(request);
+    CHECK(reply && cJSON_IsTrue(mcp::get(reply, "ok")));
+    cJSON_Delete(reply);
+    cJSON_Delete(request);
+    CHECK(thirdperson == 0 && zoom == 0 && camera1 == player && camera1->o == vec(100, 100, 600) &&
+          curfov == 90);
+    uint64_t old = mcp::view_revision;
+    execute("zoom 1");
+    recomputecamera();
+    mcp::observe_view();
+    CHECK(mcp::view_revision > old);
+    return true;
+  }
+  if (name == "native_hooks") {
+    uint64_t r = mcp::revision, g = mcp::mapmodel_generation;
+    execute("mmodel mapleaves/test");
+    CHECK(mcp::revision > r && mcp::mapmodel_generation > g && !mcp::config_supported);
+    r = mcp::revision;
+    execute("ambient 20");
+    CHECK(mcp::revision > r);
+    r = mcp::revision;
+    execute("texscale 2");
+    CHECK(mcp::revision > r);
+    r = mcp::revision;
+    mpremip(false);
+    CHECK(mcp::revision > r);
+    mcp::dirty = false;
+    mcp::lighting_dirty = false;
+    r = mcp::revision;
+    execute("clearpvs");
+    CHECK(mcp::revision > r && mcp::dirty && !mcp::lighting_dirty);
+    mcp::dirty = false;
+    r = mcp::revision;
+    clearundos();
+    CHECK(mcp::revision > r && !mcp::dirty);
+    return true;
+  }
+  cJSON_AddStringToObject(report, "failure", "unknown test case");
+  return false;
+}
diff --git a/src/tests/mcp/test_wire.cpp b/src/tests/mcp/test_wire.cpp
new file mode 100644
index 0000000..c09ce7e
--- /dev/null
+++ b/src/tests/mcp/test_wire.cpp
@@ -0,0 +1,49 @@
+#include "mcpwire.h"
+#include <assert.h>
+#include <fstream>
+#include <iterator>
+#include <stdio.h>
+int main() {
+  const char *bad[] = {
+      "{}",
+      "{\"v\":1,\"id\":\"x\",\"method\":\"editor_state\",\"params\":{},\"extra\":0}",
+      "{\"v\":1,\"id\":\"x\",\"method\":\"x\\u0000y\",\"params\":{}}",
+      "{\"v\":1,\"id\":\"x\",\"method\":\"editor_state\",\"params\":{\"a\":1,\"\\u0061\":2}}",
+      "{\"v\":1,\"id\":\"x\",\"method\":\"editor_state\",\"params\":{\"a\":1e9999}}",
+      "{\"v\":1,\"id\":\"x\",\"method\":\"editor_state\",\"params\":{\"a\":01}}",
+      "{\"v\":1,\"id\":\"x\",\"method\":\"editor_state\",\"params\":{}} {}"};
+  for (unsigned i = 0; i < sizeof(bad) / sizeof(*bad); i++) {
+    cJSON *v = 0;
+    std::string error;
+    assert(!mcp::parse_request(bad[i], v, error));
+    assert(!v);
+  }
+  cJSON *v = 0;
+  std::string error;
+  assert(mcp::parse_request("{\"v\":1,\"id\":\"x\",\"method\":\"editor_state\",\"params\":{}}", v,
+                            error));
+  cJSON_Delete(v);
+  v = cJSON_Parse("1.5");
+  int n = 0;
+  assert(!mcp::integer(v, 0, 10, n));
+  cJSON_Delete(v);
+  v = cJSON_Parse("1e9999");
+  assert(!mcp::finite_number(v));
+  cJSON_Delete(v);
+  v = cJSON_Parse("{\"b\":1,\"a\":2}");
+  assert(mcp::canonical(v) == "{\"a\":2,\"b\":1}");
+  cJSON_Delete(v);
+  std::ifstream input("tests/mcp/cases/wire.json");
+  std::string fixtures((std::istreambuf_iterator<char>(input)), std::istreambuf_iterator<char>());
+  cJSON *cases = cJSON_Parse(fixtures.c_str());
+  assert(cJSON_IsArray(cases));
+  for (cJSON *entry = cases->child; entry; entry = entry->next) {
+    cJSON *request = NULL;
+    std::string why;
+    bool parsed = mcp::parse_request(mcp::str(entry, "request"), request, why);
+    assert(parsed == bool(cJSON_IsTrue(mcp::get(entry, "valid"))));
+    cJSON_Delete(request);
+  }
+  cJSON_Delete(cases);
+  puts("wire tests: PASS");
+}
