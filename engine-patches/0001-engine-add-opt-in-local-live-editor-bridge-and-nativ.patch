+static bool safe_logical(const std::string &s) {
+  if (s.empty() || s.size() > 99 || s[0] == '/' || s.find("..") != std::string::npos)
+    return false;
+  for (size_t i = 0; i < s.size(); i++)
+    if (!((s[i] >= 'a' && s[i] <= 'z') || (s[i] >= 'A' && s[i] <= 'Z') ||
+          (s[i] >= '0' && s[i] <= '9') || s[i] == '/' || s[i] == '_' || s[i] == '-'))
+      return false;
+  return true;
+}
+static cJSON *save_stage(const cJSON *p) {
+  if (!fields(p, "|request_id||map_epoch||expected_revision||staging_id|"))
+    return error("INVALID_ARGUMENT", "unknown staging fields");
+  std::string id = str(p, "staging_id");
+  if (!uuid_valid(id))
+    return error("INVALID_ARGUMENT", "invalid staging ID");
+  if (!config_supported)
+    return error("UNSUPPORTED_CONFIG", "runtime config definitions cannot be exported");
+  char profile[PATH_MAX];
+  if (!realpath(homedir, profile))
+    return error("IO_ERROR", "profile missing");
+  std::string logical = "mcp/staging-" + id + "/level",
+              payload = std::string(profile) + "/packages/" + logical + ".ogz";
+  struct stat st;
+  if (!lstat(payload.c_str(), &st))
+    return error("REQUEST_ID_REUSED", "staging file already exists");
+  cJSON *snapshot = fingerprint();
+  if (!save_world(logical.c_str(), false, false)) {
+    cJSON_Delete(snapshot);
+    return error("IO_ERROR", "map write failed");
+  }
+  std::string sha = file_hash(payload);
+  if (sha.empty()) {
+    cJSON_Delete(snapshot);
+    return error("IO_ERROR", "cannot hash staged map");
+  }
+  cJSON *r = token_json();
+  cJSON_AddItemToObject(r, "snapshot", snapshot);
+  cJSON_AddStringToObject(r, "staging_id", id.c_str());
+  cJSON_AddStringToObject(r, "payload_path", payload.c_str());
+  cJSON_AddStringToObject(r, "payload_sha256", sha.c_str());
+  cJSON_AddBoolToObject(r, "lighting_dirty", lighting_dirty);
+  cJSON_AddStringToObject(r, "operation_id", str(p, "request_id").c_str());
+  if (!write_json_atomic(payload + ".engine.json", r)) {
+    cJSON_Delete(r);
+    return error("IO_ERROR", "cannot write staging completion report");
+  }
+  return success(r);
+}
+static cJSON *commit_open(const cJSON *p) {
+  if (!fields(p,
+              "|request_id||map_epoch||expected_revision||ticket_id||logical_name||payload_sha256||"
+              "dependency_manifest||provenance_config||public_input_hash||lighting_dirty||content_"
+              "digest||config_digest|"))
+    return error("INVALID_ARGUMENT", "unknown open fields");
+  if (get(p, "lighting_dirty") && !cJSON_IsBool(get(p, "lighting_dirty")))
+    return error("INVALID_ARGUMENT", "invalid lighting flag");
+  if (str(p, "content_digest").size() != 64 || str(p, "config_digest").size() != 64)
+    return error("INVALID_ARGUMENT", "missing validated fingerprints");
+  if (dirty && !recovery_required)
+    return error("UNSAVED_CHANGES", "save current map before opening another");
+  std::string id = str(p, "ticket_id"), logical = str(p, "logical_name");
+  if (!uuid_valid(id) || !safe_logical(logical))
+    return error("INVALID_ARGUMENT", "invalid map ticket");
+  char profile[PATH_MAX];
+  if (!realpath(homedir, profile))
+    return error("IO_ERROR", "profile missing");
+  std::string payload = std::string(profile) + "/.mcp-inputs/" + id + ".ogz",
+              sha = str(p, "payload_sha256");
+  if (sha.size() != 64 || file_hash(payload) != sha)
+    return error("DEPENDENCY_CHANGED", "pinned payload changed");
+  std::string original = "packages/" + logical + ".ogz";
+  const char *resolved = findfile(original.c_str(), "rb");
+  char abs[PATH_MAX];
+  if (!realpath(resolved, abs) || file_hash(abs) != sha)
+    return error("DEPENDENCY_CHANGED", "source map changed during validation");
+  const cJSON *deps = get(p, "dependency_manifest");
+  if (!cJSON_IsArray(deps))
+    return error("INVALID_ARGUMENT", "missing dependencies");
+  for (const cJSON *d = deps->child; d; d = d->next) {
+    std::string name = str(d, "logical");
+    if (name.empty() || name[0] == '/' || name.find("..") != std::string::npos)
+      return error("INVALID_ARGUMENT", "invalid config identity");
+    const char *path = findfile(name.c_str(), "rb");
+    char found[PATH_MAX];
+    if (!realpath(path, found) || str(d, "resolved") != found ||
+        str(d, "sha256") != file_hash(found))
+      return error("DEPENDENCY_CHANGED", "config changed during validation");
+  }
+  stream *raw = open_absolute(payload, "rb");
+  if (!raw)
+    return error("IO_ERROR", "cannot open pinned map");
+  if (stream_hash(raw) != sha) {
+    delete raw;
+    return error("DEPENDENCY_CHANGED", "opened payload no longer matches validation");
+  }
+  MapLoadReport report;
+  bool ok = load_world(logical.c_str(), NULL, raw, &report);
+  delete raw;
+  if (ok && report.ok) {
+    cJSON *observed = fingerprint();
+    if (str(observed, "content_digest") != str(p, "content_digest") ||
+        str(observed, "config_digest") != str(p, "config_digest"))
+      ok = false;
+    cJSON_Delete(observed);
+  }
+  if (!ok || !report.ok) {
+    loading = false;
+    recovery_required = true;
+    cJSON *r = error("MAP_LOAD_FAILED", "active loader failed; map state requires recovery");
+    cJSON_AddItemToObject(cJSON_GetObjectItemCaseSensitive(r, "error"), "details", state());
+    return r;
+  }
+  if (get(p, "lighting_dirty")) {
+    lighting_dirty = cJSON_IsTrue(get(p, "lighting_dirty"));
+  }
+  if (!str(p, "provenance_config").empty())
+    source_config = str(p, "provenance_config");
+  return mutation_result(p);
+}
+static cJSON *mutate(const std::string &method, const cJSON *p) {
+  if (method == "save_ack") {
+    if (!fields(p, "|request_id||map_epoch||expected_revision|"))
+      return error("INVALID_ARGUMENT", "unknown acknowledgement fields");
+    cJSON *r = token_json();
+    bool same =
+        str(p, "map_epoch") == map_epoch && str(p, "expected_revision") == decimal(revision);
+    if (same)
+      dirty = false;
+    cJSON_AddStringToObject(r, "clean_ack", same ? "applied" : "stale");
+    return success(r);
+  }
+  cJSON *guard = mutation_guard(p, method == "map_new" || method == "commit_open");
+  if (guard)
+    return guard;
+  if (shader_registry_unsupported &&
+      (method == "save_staged_map" || method == "commit_open" || method == "map_new"))
+    return error("UNSUPPORTED_CONFIG", "custom shader registry requires restarting the game");
+  if (method == "save_staged_map")
+    return save_stage(p);
+  if (method == "commit_open")
+    return commit_open(p);
+  if (method == "map_new") {
+    int scale = 0;
+    if (!fields(p, "|request_id||map_epoch||expected_revision||scale|") ||
+        !integer(get(p, "scale"), 10, 16, scale))
+      return error("INVALID_ARGUMENT", "invalid new map scale");
+    if (dirty && !recovery_required)
+      return error("UNSAVED_CHANGES", "save current map before replacing it");
+    if (!emptymap(scale, true, "", true))
+      return error("MAP_LOAD_FAILED", "new map failed");
+    if (config_failed) {
+      recovery_required = true;
+      dirty = true;
+      cJSON *r = error("MAP_LOAD_FAILED", "required default configuration failed");
+      cJSON_AddItemToObject(cJSON_GetObjectItemCaseSensitive(r, "error"), "details", state());
+      return r;
+    }
+    return mutation_result(p);
+  }
+  if (method == "geometry_fill" || method == "texture_apply" || method == "material_apply")
+    return geometry(method, p);
+  if (method == "entity_create" || method == "entity_update" || method == "entity_delete")
+    return entity_edit(method, p);
+  if (method == "camera_set")
+    return camera_set(p);
+  if (method == "history_undo" || method == "history_redo") {
+    if (!fields(p, "|request_id||map_epoch||expected_revision|"))
+      return error("INVALID_ARGUMENT", "unknown history fields");
+    const char *err = mcp_history(method == "history_redo");
+    return err ? error(err, "history was not changed") : mutation_result(p);
+  }
+  return error("INVALID_ARGUMENT", "unknown mutation");
+}
+void editor_init() { state_init(); }
+bool capture_pixels(ImageData &image) {
+  memset(image.data, 0, image.pitch * image.h);
+  int alignment = 4;
+  glGetIntegerv(GL_PACK_ALIGNMENT, &alignment);
+  for (int i = 0; i < 16 && glGetError() != GL_NO_ERROR; i++) {
+  }
+  glPixelStorei(GL_PACK_ALIGNMENT, 1);
+  glReadPixels(0, 0, image.w, image.h, GL_RGB, GL_UNSIGNED_BYTE, image.data);
+  GLenum status = glGetError();
+  glPixelStorei(GL_PACK_ALIGNMENT, alignment);
+  return status == GL_NO_ERROR;
+}
+void after_draw() {
+  if (!capture_pending)
+    return;
+  capture_pending = false;
+  if (capture_epoch != map_epoch || capture_revision != revision || capture_view != view_revision) {
+    complete(error("STALE_STATE", "frame changed before draw"));
+    return;
+  }
+  int w = min(screenw, 1280), h = int(double(screenh) * w / screenw);
+  if (h > 720) {
+    h = 720;
+    w = int(double(screenw) * h / screenh);
+  }
+  if (w < 1 || h < 1) {
+    complete(error("CAPTURE_UNAVAILABLE", "empty viewport"));
+    return;
+  }
+  ImageData full(screenw, screenh, 3), small(w, h, 3);
+  if (!capture_pixels(full)) {
+    complete(error("CAPTURE_UNAVAILABLE", "OpenGL framebuffer read failed"));
+    return;
+  }
+  for (int y = 0; y < h; y++)
+    for (int x = 0; x < w; x++)
+      memcpy(small.data + (y * w + x) * 3,
+             full.data + ((y * screenh / h) * screenw + x * screenw / w) * 3, 3);
+  std::string dir = runtime_dir() + "/images";
+  if (mkdir(dir.c_str(), 0700) && errno != EEXIST) {
+    complete(error("IO_ERROR", "cannot create capture directory"));
+    return;
+  }
+  struct stat st;
+  if (lstat(dir.c_str(), &st) || !S_ISDIR(st.st_mode) || st.st_uid != getuid() ||
+      (st.st_mode & 077)) {
+    complete(error("IO_ERROR", "capture root must be private"));
+    return;
+  }
+  std::string id = uuid(), filename = dir + "/" + id + ".png";
+  stream *raw = open_absolute(filename, "wb");
+  if (!raw) {
+    complete(error("IO_ERROR", "cannot write capture"));
+    return;
+  }
+  savepng(filename.c_str(), small, true, raw);
+  if (lstat(filename.c_str(), &st) || !S_ISREG(st.st_mode) || st.st_size < 32 ||
+      st.st_size > 4 * 1024 * 1024) {
+    unlink(filename.c_str());
+    complete(error("IO_ERROR", "invalid capture size"));
+    return;
+  }
+  cJSON *r = token_json();
+  cJSON_AddStringToObject(r, "view_revision", decimal(view_revision).c_str());
+  cJSON_AddStringToObject(r, "artifact_id", id.c_str());
+  cJSON_AddStringToObject(r, "mime", "image/png");
+  cJSON_AddNumberToObject(r, "width", w);
+  cJSON_AddNumberToObject(r, "height", h);
+  complete(success(r));
+}
+cJSON *dispatch(const cJSON *request) {
+  std::string method = str(request, "method");
+  // Native lookup/history helpers use these UI globals as scratch state.
+  // A map replacement owns their reset; ordinary RPCs preserve the user's focus.
+  struct ViewScratchGuard {
+    ivec origin;
+    int size, focus;
+    bool restore;
+    ViewScratchGuard(bool enabled) : origin(lu), size(lusize), focus(efocus), restore(enabled) {}
+    ~ViewScratchGuard() {
+      if (restore) {
+        lu = origin;
+        lusize = size;
+        efocus = focus;
+      }
+    }
+  } guard(method != "map_new" && method != "commit_open");
+  const cJSON *p = get(request, "params");
+  if (method == "editor_state")
+    return fields(p, "") ? success(state())
+                         : error("INVALID_ARGUMENT", "state takes no parameters");
+  if (method == "region_read")
+    return region(p);
+  if (method == "texture_catalog")
+    return catalog(p, false);
+  if (method == "mapmodel_catalog")
+    return catalog(p, true);
+  if (method == "entity_list")
+    return entity_list(p);
+  if (method == "view_capture")
+    return capture(p);
+  if (method == "operation_status") {
+    if (!fields(p, "|request_id|"))
+      return error("INVALID_ARGUMENT", "unknown status fields");
+    cJSON *r = cJSON_CreateObject();
+    std::map<std::string, Completed>::iterator it = completed.find(str(p, "request_id"));
+    if (it == completed.end())
+      cJSON_AddStringToObject(r, "status", "unknown");
+    else {
+      cJSON *reply = cJSON_Parse(it->second.reply.c_str());
+      bool ok = cJSON_IsTrue(get(reply, "ok"));
+      cJSON_AddStringToObject(r, "status", ok ? "completed" : "failed");
+      if (!it->second.public_input_hash.empty())
+        cJSON_AddStringToObject(r, "public_input_hash", it->second.public_input_hash.c_str());
+      cJSON_AddItemToObject(r, ok ? "result" : "error",
+                            cJSON_Duplicate(get(reply, ok ? "result" : "error"), 1));
+      cJSON_Delete(reply);
+    }
+    return success(r);
+  }
+  bool ismutation = method == "save_staged_map" || method == "save_ack" ||
+                    method == "commit_open" || method == "map_new" || method == "camera_set" ||
+                    method == "entity_create" || method == "entity_update" ||
+                    method == "entity_delete" || method == "geometry_fill" ||
+                    method == "texture_apply" || method == "material_apply" ||
+                    method == "history_undo" || method == "history_redo";
+  if (ismutation) {
+    std::string id = str(p, "request_id"), key = method + "|" + canonical(p);
+    std::map<std::string, Completed>::iterator it = completed.find(id);
+    if (it != completed.end())
+      return it->second.key == key
+                 ? cJSON_Parse(it->second.reply.c_str())
+                 : error("REQUEST_ID_REUSED", "same UUID used with different input");
+    cJSON *reply = mutate(method, p);
+    if (uuid_valid(id)) {
+      if (completion_order.size() >= 256) {
+        completed.erase(completion_order.front());
+        completion_order.erase(completion_order.begin());
+      }
+      completed[id] = Completed{key, canonical(reply), str(p, "public_input_hash")};
+      completion_order.push_back(id);
+    }
+    return reply;
+  }
+  return error("INVALID_ARGUMENT", "unknown or unavailable tool");
+}
+} // namespace mcp
