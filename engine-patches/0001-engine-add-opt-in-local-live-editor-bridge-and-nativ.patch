+extern MSlot materialslots[(MATF_VOLUME | MATF_INDEX) + 1];
+extern cJSON *mcp_sound_config();
+extern bool mcp_run_native_case(const std::string &, cJSON *);
+namespace mcp {
+std::string validation_input, validation_report, test_case;
+class AbsoluteStream : public stream {
+  FILE *file;
+
+public:
+  AbsoluteStream(FILE *f) : file(f) {}
+  ~AbsoluteStream() { close(); }
+  void close() {
+    if (file) {
+      fclose(file);
+      file = NULL;
+    }
+  }
+  bool end() { return !file || feof(file) || ferror(file); }
+  offset tell() { return file ? ftello(file) : -1; }
+  bool seek(offset p, int whence = SEEK_SET) { return file && fseeko(file, p, whence) == 0; }
+  size_t read(void *b, size_t n) { return file ? fread(b, 1, n, file) : 0; }
+  size_t write(const void *b, size_t n) { return file ? fwrite(b, 1, n, file) : 0; }
+  bool flush() { return file && fflush(file) == 0; }
+};
+stream *open_absolute(const std::string &path, const char *mode) {
+  if (path.empty() || path[0] != '/')
+    return NULL;
+  int flags = mode[0] == 'w' ? O_WRONLY | O_CREAT | O_EXCL : O_RDONLY;
+  int fd = open(path.c_str(), flags | O_CLOEXEC | O_NOFOLLOW, 0600);
+  if (fd < 0)
+    return NULL;
+  struct stat st;
+  if (fstat(fd, &st) || !S_ISREG(st.st_mode)) {
+    ::close(fd);
+    return NULL;
+  }
+  FILE *f = fdopen(fd, mode);
+  if (!f) {
+    ::close(fd);
+    return NULL;
+  }
+  return new AbsoluteStream(f);
+}
+static std::string finish(EVP_MD_CTX *ctx) {
+  unsigned char digest[32];
+  unsigned int len = 0;
+  bool ok = EVP_DigestFinal_ex(ctx, digest, &len) == 1 && len == 32;
+  EVP_MD_CTX_free(ctx);
+  if (!ok)
+    return "";
+  char hex[65];
+  for (unsigned i = 0; i < 32; i++)
+    snprintf(hex + 2 * i, 3, "%02x", digest[i]);
+  return hex;
+}
+std::string hash(const std::string &s) {
+  EVP_MD_CTX *ctx = EVP_MD_CTX_new();
+  if (!ctx)
+    return "";
+  if (EVP_DigestInit_ex(ctx, EVP_sha256(), NULL) != 1 ||
+      EVP_DigestUpdate(ctx, s.data(), s.size()) != 1) {
+    EVP_MD_CTX_free(ctx);
+    return "";
+  }
+  return finish(ctx);
+}
+std::string stream_hash(stream *input) {
+  if (!input || !input->seek(0))
+    return "";
+  EVP_MD_CTX *ctx = EVP_MD_CTX_new();
+  if (!ctx)
+    return "";
+  if (EVP_DigestInit_ex(ctx, EVP_sha256(), NULL) != 1) {
+    EVP_MD_CTX_free(ctx);
+    return "";
+  }
+  char buf[16384];
+  size_t n;
+  while ((n = input->read(buf, sizeof(buf))) > 0)
+    if (EVP_DigestUpdate(ctx, buf, n) != 1) {
+      EVP_MD_CTX_free(ctx);
+      return "";
+    }
+  if (!input->seek(0)) {
+    EVP_MD_CTX_free(ctx);
+    return "";
+  }
+  return finish(ctx);
+}
+std::string file_hash(const std::string &path) {
+  int fd = open(path.c_str(), O_RDONLY | O_CLOEXEC | O_NOFOLLOW);
+  if (fd < 0)
+    return "";
+  struct stat st;
+  if (fstat(fd, &st) || !S_ISREG(st.st_mode)) {
+    close(fd);
+    return "";
+  }
+  EVP_MD_CTX *ctx = EVP_MD_CTX_new();
+  if (!ctx || EVP_DigestInit_ex(ctx, EVP_sha256(), NULL) != 1) {
+    if (ctx)
+      EVP_MD_CTX_free(ctx);
+    close(fd);
+    return "";
+  }
+  char buf[16384];
+  ssize_t n;
+  while ((n = read(fd, buf, sizeof(buf))) > 0)
+    if (EVP_DigestUpdate(ctx, buf, n) != 1) {
+      EVP_MD_CTX_free(ctx);
+      close(fd);
+      return "";
+    }
+  close(fd);
+  if (n < 0) {
+    EVP_MD_CTX_free(ctx);
+    return "";
+  }
+  return finish(ctx);
+}
+bool write_json_atomic(const std::string &path, const cJSON *v) {
+  std::string temp = path + "." + uuid() + ".tmp", data = canonical(v) + "\n";
+  int fd = open(temp.c_str(), O_WRONLY | O_CREAT | O_EXCL | O_NOFOLLOW | O_CLOEXEC, 0600);
+  if (fd < 0)
+    return false;
+  size_t offset = 0;
+  while (offset < data.size()) {
+    ssize_t n = write(fd, data.data() + offset, data.size() - offset);
+    if (n <= 0) {
+      close(fd);
+      unlink(temp.c_str());
+      return false;
+    }
+    offset += n;
+  }
+  bool ok = fsync(fd) == 0;
+  if (close(fd))
+    ok = false;
+  if (ok)
+    ok = rename(temp.c_str(), path.c_str()) == 0;
+  if (!ok)
+    unlink(temp.c_str());
+  return ok;
+}
+class HashStream : public stream {
+  EVP_MD_CTX *ctx;
+  size_t count;
+  bool good;
+
+public:
+  HashStream() : ctx(EVP_MD_CTX_new()), count(0), good(false) {
+    good = ctx && EVP_DigestInit_ex(ctx, EVP_sha256(), NULL) == 1;
+  }
+  ~HashStream() { close(); }
+  void close() {
+    if (ctx)
+      EVP_MD_CTX_free(ctx);
+    ctx = NULL;
+  }
+  bool end() { return !good; }
+  offset tell() { return count; }
+  size_t write(const void *data, size_t len) {
+    if (!good || EVP_DigestUpdate(ctx, data, len) != 1) {
+      good = false;
+      return 0;
+    }
+    count += len;
+    return len;
+  }
+  void number(int n) { putlil<int>(n); }
+  std::string digest() {
+    if (!good)
+      return "";
+    std::string result = finish(ctx);
+    ctx = NULL;
+    return result;
+  }
+};
+static std::string auxiliary_digest() {
+  HashStream data;
+  data.number(lightmaps.length());
+  loopv(lightmaps) {
+    const LightMap &lm = lightmaps[i];
+    data.number(lm.type);
+    data.number(lm.bpp);
+    data.number(lm.unlitx);
+    data.number(lm.unlity);
+    if (lm.data)
+      data.write(lm.data, lm.bpp * LM_PACKW * LM_PACKH);
+  }
+  data.number(getnumviewcells());
+  if (getnumviewcells())
+    savepvs(&data);
+  data.number(shouldsaveblendmap());
+  if (shouldsaveblendmap())
+    saveblendmap(&data);
+  return data.digest();
+}
+static void numbers(cJSON *o, const char *key, const float *n, int count) {
+  cJSON *a = cJSON_AddArrayToObject(o, key);
+  for (int i = 0; i < count; i++)
+    cJSON_AddItemToArray(a, cJSON_CreateNumber(n[i]));
+}
+static cJSON *params(const vector<SlotShaderParam> &ps) {
+  cJSON *a = cJSON_CreateArray();
+  loopv(ps) {
+    cJSON *p = cJSON_CreateObject();
+    cJSON_AddStringToObject(p, "name", ps[i].name);
+    numbers(p, "value", ps[i].val, 4);
+    cJSON_AddItemToArray(a, p);
+  }
+  return a;
+}
+static cJSON *vslot_semantic(const VSlot &v) {
+  cJSON *r = cJSON_CreateObject();
+  cJSON *ts = cJSON_AddArrayToObject(r, "textures");
+  if (v.slot) {
+    loopv(v.slot->sts) {
+      cJSON *t = cJSON_CreateObject();
+      cJSON_AddNumberToObject(t, "type", v.slot->sts[i].type);
+      cJSON_AddStringToObject(t, "name", v.slot->sts[i].name);
+      cJSON_AddItemToArray(ts, t);
+    }
+    cJSON_AddStringToObject(r, "shader", v.slot->shader ? v.slot->shader->name : "");
+    cJSON_AddItemToObject(r, "slot_params", params(v.slot->params));
+  }
+  cJSON_AddItemToObject(r, "params", params(v.params));
+  cJSON_AddNumberToObject(r, "scale", v.scale);
+  cJSON_AddNumberToObject(r, "rotation", v.rotation);
+  cJSON_AddNumberToObject(r, "offset_x", v.offset.x);
+  cJSON_AddNumberToObject(r, "offset_y", v.offset.y);
+  cJSON_AddNumberToObject(r, "scroll_x", v.scroll.x);
+  cJSON_AddNumberToObject(r, "scroll_y", v.scroll.y);
+  cJSON_AddNumberToObject(r, "alphafront", v.alphafront);
+  cJSON_AddNumberToObject(r, "alphaback", v.alphaback);
+  numbers(r, "colorscale", v.colorscale.v, 3);
+  if (v.layer && vslots.inrange(v.layer) && vslots[v.layer]->slot &&
+      !vslots[v.layer]->slot->sts.empty())
+    cJSON_AddStringToObject(r, "layer", vslots[v.layer]->slot->sts[0].name);
+  return r;
+}
+static cJSON *slot_semantic(const Slot &s) {
+  cJSON *r = cJSON_CreateObject(), *textures = cJSON_AddArrayToObject(r, "textures");
+  loopv(s.sts) {
+    cJSON *t = cJSON_CreateObject();
+    cJSON_AddStringToObject(t, "name", s.sts[i].name);
+    cJSON_AddNumberToObject(t, "type", s.sts[i].type);
+    cJSON_AddItemToArray(textures, t);
+  }
+  cJSON_AddStringToObject(r, "shader", s.shader ? s.shader->name : "");
+  cJSON_AddItemToObject(r, "params", params(s.params));
+  cJSON_AddStringToObject(r, "autograss", s.autograss ? s.autograss : "");
+  cJSON_AddStringToObject(r, "layermask", s.layermaskname ? s.layermaskname : "");
+  cJSON_AddNumberToObject(r, "layermask_mode", s.layermaskmode);
+  cJSON_AddNumberToObject(r, "layermask_scale", s.layermaskscale);
+  if (s.variants)
+    cJSON_AddItemToObject(r, "base_variant", vslot_semantic(*s.variants));
+  return r;
+}
+struct TreeDigest {
+  std::string hash, payload;
+  bool uniform;
+};
+static TreeDigest digest_cube(const cube &c, const std::vector<std::string> &textures) {
+  if (c.children) {
+    TreeDigest children[8];
+    bool same = true;
+    std::string all = "node:";
+    for (int i = 0; i < 8; i++) {
+      children[i] = digest_cube(c.children[i], textures);
+      all += children[i].hash;
+      if (i && (!children[i].uniform || children[i].payload != children[0].payload))
+        same = false;
+    }
+    if (same && children[0].uniform)
+      return children[0];
+    return TreeDigest{hash(all), "", false};
+  }
+  cJSON *j = cJSON_CreateObject();
+  int edges[12];
+  for (int i = 0; i < 12; i++)
+    edges[i] = c.edges[i];
+  cJSON_AddItemToObject(j, "edges", cJSON_CreateIntArray(edges, 12));
+  cJSON_AddNumberToObject(j, "material", c.material);
+  cJSON *a = cJSON_AddArrayToObject(j, "textures");
+  for (int i = 0; i < 6; i++)
+    cJSON_AddItemToArray(a, cJSON_CreateString(c.texture[i] < textures.size()
+                                                   ? textures[c.texture[i]].c_str()
+                                                   : "invalid"));
+  std::string data = canonical(j);
+  cJSON_Delete(j);
+  return TreeDigest{hash("leaf:" + data), data, isempty(c) || isentirelysolid(c)};
+}
+cJSON *fingerprint() {
+  std::vector<std::string> textures;
+  loopv(vslots) {
+    cJSON *j = vslot_semantic(*vslots[i]);
+    textures.push_back(hash(canonical(j)));
+    cJSON_Delete(j);
+  }
+  std::string geometry = "world:" + decimal(worldsize);
+  for (int i = 0; i < 8; i++)
+    geometry += digest_cube(worldroot[i], textures).hash;
+  std::vector<std::string> entities_json;
+  const vector<extentity *> &ents = entities::getents();
+  loopv(ents) {
+    const extentity &e = *ents[i];
+    if (e.type == ET_EMPTY)
+      continue;
+    cJSON *j = cJSON_CreateObject();
+    numbers(j, "position", e.o.v, 3);
+    cJSON_AddStringToObject(j, "type", entities::entname(e.type));
+    int attrs[] = {e.attr1, e.attr2, e.attr3, e.attr4, e.attr5};
+    if (e.type == ET_MAPMODEL) {
+      cJSON_AddStringToObject(j, "model",
+                              mapmodelname(e.attr2) ? mapmodelname(e.attr2) : "invalid");
+      attrs[1] = 0;
+    }
+    cJSON_AddItemToObject(j, "attrs", cJSON_CreateIntArray(attrs, 5));
+    entities_json.push_back(canonical(j));
+    cJSON_Delete(j);
+  }
+  std::sort(entities_json.begin(), entities_json.end());
+  for (size_t i = 0; i < entities_json.size(); i++)
+    geometry += entities_json[i];
+  cJSON *config = cJSON_CreateObject(), *slotlist = cJSON_AddArrayToObject(config, "slots");
+  loopv(slots) cJSON_AddItemToArray(slotlist, slot_semantic(*slots[i]));
+  cJSON *materials = cJSON_AddArrayToObject(config, "materials");
+  for (int i = 0; i <= (MATF_VOLUME | MATF_INDEX); i++)
+    cJSON_AddItemToArray(materials, slot_semantic(materialslots[i]));
+  cJSON *models = cJSON_AddArrayToObject(config, "models");
+  loopv(mapmodels) cJSON_AddItemToArray(models, cJSON_CreateString(mapmodels[i].name));
+  cJSON_AddItemToObject(config, "mapsounds", mcp_sound_config());
+  cJSON *vars = cJSON_AddObjectToObject(config, "vars");
+  enumerate(idents, ident, id, {
+    if ((id.flags & IDF_OVERRIDE) && (id.flags & IDF_OVERRIDDEN) && !(id.flags & IDF_READONLY)) {
+      if (id.type == ID_VAR)
+        cJSON_AddNumberToObject(vars, id.name, *id.storage.i);
+      else if (id.type == ID_FVAR)
+        cJSON_AddNumberToObject(vars, id.name, *id.storage.f);
+      else if (id.type == ID_SVAR)
+        cJSON_AddStringToObject(vars, id.name, *id.storage.s);
+    }
+  });
+  std::string config_data = canonical(config);
+  geometry += canonical(vars);
+  geometry += auxiliary_digest();
+  cJSON_Delete(config);
+  cJSON *r = cJSON_CreateObject();
+  cJSON_AddStringToObject(r, "content_digest", hash(geometry).c_str());
+  cJSON_AddStringToObject(r, "config_digest", hash(config_data).c_str());
+  cJSON_AddNumberToObject(r, "worldsize", worldsize);
+  cJSON_AddStringToObject(r, "source_config", source_config.c_str());
+  cJSON *deps = cJSON_AddArrayToObject(r, "dependency_manifest");
+  for (size_t i = 0; i < config_files.size(); i++) {
+    const char *found = findfile(config_files[i].c_str(), "rb");
+    char resolved[PATH_MAX];
+    if (!realpath(found, resolved))
+      continue;
+    std::string sha = file_hash(resolved);
+    if (sha.empty())
+      continue;
+    cJSON *d = cJSON_CreateObject();
+    cJSON_AddStringToObject(d, "logical", config_files[i].c_str());
+    cJSON_AddStringToObject(d, "resolved", resolved);
+    cJSON_AddStringToObject(d, "sha256", sha.c_str());
+    cJSON_AddItemToArray(deps, d);
+  }
+  return r;
+}
+bool run_validation() {
+  if (validation_report.empty() || (validation_input.empty() && test_case.empty()))
+    return false;
+  bool ok = false;
+  cJSON *report = cJSON_CreateObject();
+  cJSON_AddNumberToObject(report, "schema_version", 1);
+  if (!test_case.empty()) {
+    enable_test_mode();
+    ok = mcp_run_native_case(test_case, report);
+  } else {
+    FILE *f = fopen(validation_input.c_str(), "rb");
+    std::string text;
+    char buf[8192];
+    if (f) {
+      size_t n;
+      while ((n = fread(buf, 1, sizeof(buf), f)) > 0 && text.size() < 1024 * 1024)
+        text.append(buf, n);
+      fclose(f);
+    }
+    cJSON *request = NULL;
+    std::string err;
+    if (parse_request(text, request, err)) {
+      const cJSON *p = get(request, "params");
+      std::string payload = str(p, "payload_path"), logical = str(p, "logical_name");
+      if (!payload.empty() && file_hash(payload) == str(p, "payload_sha256")) {
+        stream *raw = open_absolute(payload, "rb");
+        MapLoadReport lr;
+        if (raw) {
+          if (stream_hash(raw) == str(p, "payload_sha256"))
+            ok = load_world(logical.c_str(), NULL, raw, &lr) && lr.ok;
+          delete raw;
+        }
+        cJSON_AddBoolToObject(report, "load_report", ok);
+        ok = ok && !shader_registry_unsupported;
+        if (ok) {
+          cJSON *fp = fingerprint();
+          if (str(p, "mode") == "compare")
+            ok = str(fp, "content_digest") == str(p, "content_digest") &&
+                 str(fp, "config_digest") == str(p, "config_digest");
+          cJSON_AddItemToObject(report, "fingerprint", fp);
+        }
+      }
+      cJSON_Delete(request);
+    }
+  }
+  cJSON_AddBoolToObject(report, "ok", ok);
+  cJSON_AddStringToObject(report, "renderer", (const char *)glGetString(GL_RENDERER));
+  bool wrote = write_json_atomic(validation_report, report);
+  cJSON_Delete(report);
+  mcp::shutdown();
+  cleanup();
+  exit(wrote ? (ok ? 0 : 2) : 3);
+  return true;
+}
+} // namespace mcp
