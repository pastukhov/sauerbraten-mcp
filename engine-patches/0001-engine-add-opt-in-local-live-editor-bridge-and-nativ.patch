+  cJSON_AddBoolToObject(selection, "explicit", havesel);
+  cJSON_AddItemToObject(selection, "origin", arr3(sel.o.x, sel.o.y, sel.o.z));
+  cJSON_AddItemToObject(selection, "count", arr3(sel.s.x, sel.s.y, sel.s.z));
+  cJSON_AddNumberToObject(selection, "grid", sel.grid);
+  cJSON_AddNumberToObject(selection, "orient", sel.orient);
+  cJSON *flags = cJSON_AddObjectToObject(r, "multiplayer_flags");
+  cJSON_AddBoolToObject(flags, "remote", curpeer != NULL);
+  cJSON_AddBoolToObject(flags, "connecting", connpeer != NULL);
+  cJSON_AddBoolToObject(flags, "nonlocal_clients", hasnonlocalclients());
+  cJSON_AddBoolToObject(flags, "demo", game::demoplayback);
+  cJSON *limits = cJSON_AddObjectToObject(r, "limits");
