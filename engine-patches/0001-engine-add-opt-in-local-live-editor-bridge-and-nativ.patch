+#!/usr/bin/env python3
+"""Exercise the initialized engine without installing the external Python SDK."""
+import argparse
+import json
+from pathlib import Path
+import subprocess
+import tempfile
+
+CASES = [
+  "boot", "exact_faces", "undo_interleave", "read_boundaries",
+  "entity_boundary_selected", "entity_boundary_hover", "attached_history",
+  "history_accounting", "allocation_failure", "native_hooks", "aux_fingerprint",
+  "capture_error", "remote_native_history", "config_edits", "camera_modes",
+  "rpc_view_state", "shader_registry",
+]
+
+
+def main():
+  src = Path(__file__).resolve().parents[2]
+  parser = argparse.ArgumentParser(description=__doc__)
+  parser.add_argument("--client", type=Path, default=src / "sauer_client")
+  parser.add_argument("--data", type=Path, default=src.parent)
+  args = parser.parse_args()
+  client, data = args.client.resolve(), args.data.resolve()
+  for case in CASES:
+    with tempfile.TemporaryDirectory(prefix="sauer-mcp-native-") as directory:
+      work = Path(directory)
+      report = work / "report.json"
+      result = subprocess.run([
+        "xvfb-run", "-a", str(client), f"-q{work}/profile", "-t0", "-w640", "-h480",
+        "--mcp-test-case", case, "--mcp-report", str(report),
+      ], cwd=data, stdout=subprocess.PIPE, stderr=subprocess.STDOUT, timeout=30)
+      if result.returncode != 0 or not report.is_file():
+        raise RuntimeError(f"{case}: exit {result.returncode}\n{result.stdout.decode(errors='replace')[-2000:]}")
+      details = json.loads(report.read_text())
+      if not details.get("ok"):
+        raise RuntimeError(f"{case}: {details}")
+      print(f"{case}: PASS", flush=True)
+  print(f"{len(CASES)} initialized native cases passed")
+
+
+if __name__ == "__main__":
+  main()
