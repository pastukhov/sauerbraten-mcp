diff --git a/src/engine/mcpbridge.cpp b/src/engine/mcpbridge.cpp
new file mode 100644
index 0000000..54d3e19
--- /dev/null
+++ b/src/engine/mcpbridge.cpp
@@ -0,0 +1,207 @@
+#include "mcpbridge.h"
+#include <errno.h>
+#include <fcntl.h>
+#include <string.h>
+#include <sys/socket.h>
+#include <sys/stat.h>
+#include <sys/un.h>
+#include <time.h>
+#include <unistd.h>
+namespace mcp {
+static int listener = -1, peer = -1;
+static std::string socketpath, incoming, outgoing, activeid;
+static size_t written = 0;
+static double output_since = 0;
+static dev_t own_dev;
+static ino_t own_ino;
+static double now() {
+  struct timespec t;
+  clock_gettime(CLOCK_MONOTONIC, &t);
+  return t.tv_sec + t.tv_nsec / 1e9;
+}
+static bool testing = false;
+void enable_test_mode() { testing = true; }
+bool enabled() { return listener >= 0 || testing; }
+std::string runtime_dir() {
+  size_t p = socketpath.rfind('/');
+  return p == std::string::npos ? "" : socketpath.substr(0, p);
+}
+static void disconnect_peer() {
+  if (peer >= 0)
+    close(peer);
+  peer = -1;
+  incoming.clear();
+  outgoing.clear();
+  activeid.clear();
+  written = 0;
+}
+void shutdown() {
+  disconnect_peer();
+  if (listener >= 0)
+    close(listener);
+  listener = -1;
+  struct stat st;
+  if (!socketpath.empty() && !lstat(socketpath.c_str(), &st) && st.st_dev == own_dev &&
+      st.st_ino == own_ino)
+    unlink(socketpath.c_str());
+  socketpath.clear();
+}
+bool init(const char *path) {
+  if (!path || path[0] != '/' || strlen(path) >= sizeof(((sockaddr_un *)0)->sun_path))
+    return false;
+  socketpath = path;
+  struct stat st;
+  std::string parent = runtime_dir();
+  for (size_t i = 1; i < parent.size(); i++)
+    if (parent[i] == '/') {
+      std::string component = parent.substr(0, i);
+      if (lstat(component.c_str(), &st) || S_ISLNK(st.st_mode))
+        return false;
+    }
+  if (lstat(parent.c_str(), &st) || !S_ISDIR(st.st_mode) || st.st_uid != getuid() ||
+      (st.st_mode & 077) != 0)
+    return false;
+  if (!lstat(path, &st)) {
+    if (!S_ISSOCK(st.st_mode) || st.st_uid != getuid())
+      return false;
+    int probe = socket(AF_UNIX, SOCK_STREAM | SOCK_CLOEXEC, 0);
+    sockaddr_un a = {};
+    a.sun_family = AF_UNIX;
+    strcpy(a.sun_path, path);
+    int r = connect(probe, (sockaddr *)&a, sizeof(a));
+    int err = errno;
+    close(probe);
+    if (!r || err != ECONNREFUSED)
+      return false;
+    if (unlink(path))
+      return false;
+  } else if (errno != ENOENT)
+    return false;
+  listener = socket(AF_UNIX, SOCK_STREAM | SOCK_NONBLOCK | SOCK_CLOEXEC, 0);
+  if (listener < 0)
+    return false;
+  sockaddr_un a = {};
+  a.sun_family = AF_UNIX;
+  strcpy(a.sun_path, path);
+  if (bind(listener, (sockaddr *)&a, sizeof(a)) || chmod(path, 0600) || listen(listener, 2)) {
+    close(listener);
+    listener = -1;
+    return false;
+  }
+  if (lstat(path, &st)) {
+    close(listener);
+    listener = -1;
+    return false;
+  }
+  own_dev = st.st_dev;
+  own_ino = st.st_ino;
+  return true;
+}
+void complete(cJSON *reply) {
+  if (peer < 0 || activeid.empty()) {
+    cJSON_Delete(reply);
+    return;
+  }
+  cJSON_AddNumberToObject(reply, "v", 1);
+  cJSON_AddStringToObject(reply, "id", activeid.c_str());
+  outgoing = canonical(reply) + "\n";
+  cJSON_Delete(reply);
+  written = 0;
+  output_since = now();
+  if (outgoing.size() > 256 * 1024) {
+    disconnect_peer();
+    return;
+  }
+}
+void poll(Dispatch dispatch) {
+  if (listener < 0)
+    return;
+  for (int i = 0; i < 2; i++) {
+    int fd = accept4(listener, 0, 0, SOCK_NONBLOCK | SOCK_CLOEXEC);
+    if (fd < 0)
+      break;
+    struct ucred cred;
+    socklen_t n = sizeof(cred);
+    if (getsockopt(fd, SOL_SOCKET, SO_PEERCRED, &cred, &n) || cred.uid != getuid()) {
+      close(fd);
+      continue;
+    }
+    if (peer >= 0) {
+      const char msg[] = "{\"v\":1,\"id\":\"\",\"ok\":false,\"error\":{\"code\":\"BUSY\","
+                         "\"message\":\"bridge already attached\"}}\n";
+      send(fd, msg, sizeof(msg) - 1, MSG_NOSIGNAL);
+      close(fd);
+    } else
+      peer = fd;
+  }
+  if (peer < 0)
+    return;
+  if (!outgoing.empty()) {
+    if (now() - output_since > 5) {
+      disconnect_peer();
+      return;
+    }
+    ssize_t n = send(peer, outgoing.data() + written, outgoing.size() - written, MSG_NOSIGNAL);
+    if (n > 0)
+      written += n;
+    else if (n < 0 && errno != EAGAIN && errno != EWOULDBLOCK && errno != EINTR) {
+      disconnect_peer();
+      return;
+    }
+    if (written == outgoing.size()) {
+      outgoing.clear();
+      activeid.clear();
+      written = 0;
+    }
+    return;
+  }
+  if (!activeid.empty())
+    return; // frame capture owns this request until after_draw
+  char buf[16384];
+  double deadline = now() + 0.002;
+  while (now() < deadline) {
+    ssize_t n = recv(peer, buf, sizeof(buf), 0);
+    if (n > 0) {
+      incoming.append(buf, n);
+      if (incoming.size() > 1024 * 1024) {
+        disconnect_peer();
+        return;
+      }
+      if (incoming.find('\n') != std::string::npos)
+        break;
+    } else if (n == 0) {
+      disconnect_peer();
+      return;
+    } else {
+      if (errno != EAGAIN && errno != EWOULDBLOCK && errno != EINTR)
+        disconnect_peer();
+      break;
+    }
+  }
+  size_t end = incoming.find('\n');
+  if (peer < 0 || end == std::string::npos)
+    return;
+  std::string line = incoming.substr(0, end);
+  incoming.erase(0, end + 1);
+  // Queue cap counts complete lines, including requests buffered by a pipelining client.
+  size_t lines = 0;
+  for (size_t i = 0; i < incoming.size(); i++)
+    if (incoming[i] == '\n')
+      lines++;
+  if (lines > 16) {
+    disconnect_peer();
+    return;
+  }
+  cJSON *request = 0;
+  std::string error;
+  if (!parse_request(line, request, error)) {
+    disconnect_peer();
+    return;
+  }
+  activeid = str(request, "id");
+  cJSON *reply = dispatch(request);
+  cJSON_Delete(request);
+  if (reply)
+    complete(reply);
+}
+} // namespace mcp
