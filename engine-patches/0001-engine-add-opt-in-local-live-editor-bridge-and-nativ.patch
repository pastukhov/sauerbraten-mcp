+static cJSON *error(const char *code, const char *message) {
+  cJSON *r = cJSON_CreateObject();
+  cJSON_AddBoolToObject(r, "ok", false);
+  cJSON *e = cJSON_AddObjectToObject(r, "error");
+  cJSON_AddStringToObject(e, "code", code);
