index 0000000..72cb856
--- /dev/null
+++ b/src/engine/mcpwire.cpp
@@ -0,0 +1,282 @@
+#include "mcpwire.h"
+#include <algorithm>
+#include <stdint.h>
+#include <stdlib.h>
+#include <string.h>
+#include <vector>
+namespace mcp {
+const cJSON *get(const cJSON *o, const char *k) { return cJSON_GetObjectItemCaseSensitive(o, k); }
+std::string str(const cJSON *o, const char *k) {
+  const cJSON *v = get(o, k);
+  return cJSON_IsString(v) ? v->valuestring : "";
+}
+bool finite_number(const cJSON *v) {
+  if (!cJSON_IsNumber(v))
+    return false;
+  uint64_t bits;
+  memcpy(&bits, &v->valuedouble, sizeof(bits));
+  return (bits & UINT64_C(0x7ff0000000000000)) != UINT64_C(0x7ff0000000000000);
+}
+bool integer(const cJSON *v, int lo, int hi, int &out) {
+  if (!finite_number(v) || v->valuedouble < lo || v->valuedouble > hi)
+    return false;
+  int n = int(v->valuedouble);
+  if (double(n) != v->valuedouble)
+    return false;
+  out = n;
+  return true;
+}
+bool fields(const cJSON *o, const char *allowed) {
+  if (!cJSON_IsObject(o))
+    return false;
+  for (const cJSON *v = o->child; v; v = v->next) {
+    std::string key = "|" + std::string(v->string) + "|";
+    if (std::string(allowed).find(key) == std::string::npos)
+      return false;
+  }
+  return true;
+}
+// Validate JSON lexical grammar, UTF-8 and NUL before passing strings to cJSON.
+struct Lexer {
+  const std::string &s;
+  size_t p;
+  int depth, values;
+  Lexer(const std::string &s) : s(s), p(0), depth(0), values(0) {}
+  void ws() {
+    while (p < s.size() && (s[p] == ' ' || s[p] == '\r' || s[p] == '\t'))
+      p++;
+  }
+  bool quoted() {
+    if (p >= s.size() || s[p++] != '"')
+      return false;
+    while (p < s.size()) {
+      unsigned char c = s[p++];
+      if (c == '"')
+        return true;
+      if (c < 32)
+        return false;
+      if (c == '\\') {
+        if (p >= s.size())
+          return false;
+        c = s[p++];
+        if (c == 'u') {
+          if (p + 4 > s.size())
+            return false;
+          unsigned n = 0;
+          for (int i = 0; i < 4; i++) {
+            char h = s[p++];
+            int v = h >= '0' && h <= '9'   ? h - '0'
+                    : h >= 'a' && h <= 'f' ? h - 'a' + 10
+                    : h >= 'A' && h <= 'F' ? h - 'A' + 10
+                                           : -1;
+            if (v < 0)
+              return false;
+            n = n * 16 + v;
+          }
+          if (!n)
+            return false;
+          if (n >= 0xD800 && n <= 0xDBFF) {
+            if (p + 6 > s.size() || s[p] != '\\' || s[p + 1] != 'u')
+              return false;
+            p += 2;
+            unsigned low = 0;
+            for (int i = 0; i < 4; i++) {
+              char h = s[p++];
+              int v = h >= '0' && h <= '9'   ? h - '0'
+                      : h >= 'a' && h <= 'f' ? h - 'a' + 10
+                      : h >= 'A' && h <= 'F' ? h - 'A' + 10
+                                             : -1;
+              if (v < 0)
+                return false;
+              low = low * 16 + v;
+            }
+            if (low < 0xDC00 || low > 0xDFFF)
+              return false;
+          } else if (n >= 0xDC00 && n <= 0xDFFF)
+            return false;
+        } else if (std::string("\"\\/bfnrt").find(char(c)) == std::string::npos)
+          return false;
+      } else if (c >= 128) {
+        unsigned code = 0;
+        int n = 0;
+        if (c >= 0xC2 && c <= 0xDF) {
+          code = c & 31;
+          n = 1;
+        } else if (c >= 0xE0 && c <= 0xEF) {
+          code = c & 15;
+          n = 2;
+        } else if (c >= 0xF0 && c <= 0xF4) {
+          code = c & 7;
+          n = 3;
+        } else
+          return false;
+        for (int i = 0; i < n; i++) {
+          if (p >= s.size())
+            return false;
+          unsigned char b = s[p++];
+          if ((b & 0xC0) != 0x80)
+            return false;
+          code = (code << 6) | (b & 63);
+        }
+        if ((n == 2 && code < 0x800) || (n == 3 && code < 0x10000) || code > 0x10FFFF ||
+            (code >= 0xD800 && code <= 0xDFFF))
+          return false;
+      }
+    }
+    return false;
+  }
+  bool value() {
+    ws();
+    if (p >= s.size() || depth >= 16 || ++values > 16384)
+      return false;
+    char c = s[p];
+    if (c == '"')
+      return quoted();
+    if (c == '{' || c == '[') {
+      ++depth;
+      ++p;
+      ws();
+      char close = c == '{' ? '}' : ']';
+      if (p < s.size() && s[p] == close) {
+        ++p;
+        --depth;
+        return true;
+      }
+      for (;;) {
+        if (c == '{') {
+          ws();
+          if (!quoted())
+            return false;
+          ws();
+          if (p >= s.size() || s[p++] != ':')
+            return false;
+        }
+        if (!value())
+          return false;
+        ws();
+        if (p >= s.size())
+          return false;
+        char d = s[p++];
+        if (d == close) {
+          --depth;
+          return true;
+        }
+        if (d != ',')
+          return false;
+      }
+    }
+    const char *lits[] = {"true", "false", "null"};
+    for (int i = 0; i < 3; i++) {
+      size_t n = strlen(lits[i]);
+      if (s.compare(p, n, lits[i]) == 0) {
+        p += n;
+        return true;
+      }
+    }
+    size_t start = p;
+    if (s[p] == '-')
+      p++;
+    if (p >= s.size())
+      return false;
+    if (s[p] == '0')
+      p++;
+    else {
+      if (s[p] < '1' || s[p] > '9')
+        return false;
+      while (p < s.size() && s[p] >= '0' && s[p] <= '9')
+        p++;
+    }
+    if (p < s.size() && s[p] == '.') {
+      p++;
+      size_t a = p;
+      while (p < s.size() && s[p] >= '0' && s[p] <= '9')
+        p++;
+      if (p == a)
+        return false;
+    }
+    if (p < s.size() && (s[p] == 'e' || s[p] == 'E')) {
+      p++;
+      if (p < s.size() && (s[p] == '+' || s[p] == '-'))
+        p++;
+      size_t a = p;
+      while (p < s.size() && s[p] >= '0' && s[p] <= '9')
+        p++;
+      if (a == p)
+        return false;
+    }
+    return p > start;
+  }
+};
+static bool tree_valid(const cJSON *v) {
+  if (cJSON_IsNumber(v) && !finite_number(v))
+    return false;
+  for (const cJSON *a = v->child; a; a = a->next) {
+    if (cJSON_IsObject(v) && strlen(a->string) > 64)
+      return false;
+    if (cJSON_IsObject(v))
+      for (const cJSON *b = v->child; b != a; b = b->next)
+        if (!strcmp(a->string, b->string))
+          return false;
+    if (!tree_valid(a))
+      return false;
+  }
+  return true;
+}
+bool parse_request(const std::string &line, cJSON *&out, std::string &error) {
+  out = 0;
+  error = "invalid request";
+  if (line.size() > 1024 * 1024)
+    return false;
+  Lexer l(line);
+  if (!l.value())
+    return false;
+  l.ws();
+  if (l.p != line.size())
+    return false;
+  cJSON *v = cJSON_ParseWithLength(line.c_str(), line.size() + 1);
+  if (!v)
+    return false;
+  int version = 0;
+  bool ok = tree_valid(v) && fields(v, "|v||id||method||params|") &&
+            integer(get(v, "v"), 1, 1, version) && cJSON_IsObject(get(v, "params"));
+  std::string id = str(v, "id"), method = str(v, "method");
+  ok = ok && !id.empty() && id.size() <= 64 && !method.empty() && method.size() <= 64;
+  for (size_t i = 0; i < id.size(); i++)
+    if ((unsigned char)id[i] < 33 || (unsigned char)id[i] > 126)
+      ok = false;
+  if (!ok) {
+    cJSON_Delete(v);
+    return false;
+  }
+  out = v;
+  return true;
+}
+static cJSON *sorted(const cJSON *v) {
+  if (cJSON_IsObject(v)) {
+    std::vector<const cJSON *> children;
+    for (const cJSON *c = v->child; c; c = c->next)
+      children.push_back(c);
+    std::sort(children.begin(), children.end(),
+              [](const cJSON *a, const cJSON *b) { return strcmp(a->string, b->string) < 0; });
+    cJSON *o = cJSON_CreateObject();
+    for (size_t i = 0; i < children.size(); i++)
+      cJSON_AddItemToObject(o, children[i]->string, sorted(children[i]));
+    return o;
+  }
+  if (cJSON_IsArray(v)) {
+    cJSON *o = cJSON_CreateArray();
+    for (const cJSON *c = v->child; c; c = c->next)
+      cJSON_AddItemToArray(o, sorted(c));
+    return o;
+  }
+  return cJSON_Duplicate(v, 0);
+}
+std::string canonical(const cJSON *v) {
+  cJSON *copy = sorted(v);
+  char *p = cJSON_PrintUnformatted(copy);
+  std::string s = p ? p : "null";
+  free(p);
+  cJSON_Delete(copy);
+  return s;
+}
+} // namespace mcp
