+    cJSON_AddNumberToObject(c, "yaw", camera1->yaw);
+    cJSON_AddNumberToObject(c, "pitch", camera1->pitch);
+    cJSON_AddNumberToObject(c, "fov", curfov);
+    cJSON_AddNumberToObject(c, "base_fov", fov);
