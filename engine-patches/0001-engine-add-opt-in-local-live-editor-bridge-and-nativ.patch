+static std::string last_view;
+void observe_view() {
+  if (!tracking || !camera1)
+    return;
+  char signature[512];
+  snprintf(signature, sizeof(signature),
+           "%.9g,%.9g,%.9g,%.9g,%.9g,%.9g,%.9g,%.9g,%d,%d:%d,%d,%d:%d,%d,%d:%d:%d", camera1->o.x,
+           camera1->o.y, camera1->o.z, camera1->yaw, camera1->pitch, camera1->roll, curfov,
+           forceaspect, screenw, screenh, havesel ? sel.o.x : 0, havesel ? sel.o.y : 0,
+           havesel ? sel.o.z : 0, havesel ? sel.s.x : 0, havesel ? sel.s.y : 0,
+           havesel ? sel.s.z : 0, havesel ? sel.grid : 0, havesel ? sel.orient : 0);
+  if (!last_view.empty() && last_view != signature)
+    ++view_revision;
+  last_view = signature;
+}
+static cJSON *camera_set(const cJSON *p) {
+  if (!fields(p, "|request_id||map_epoch||expected_revision||position||yaw||pitch||fov|"))
+    return error("INVALID_ARGUMENT", "unknown camera fields");
+  float pos[3];
+  if (!floats3(get(p, "position"), pos, 0, float(worldsize)))
+    return error("INVALID_ARGUMENT", "invalid camera position");
+  const cJSON *y = get(p, "yaw"), *pitch = get(p, "pitch");
+  int field = 100;
+  if (!finite_number(y) || y->valuedouble < 0 || y->valuedouble >= 360 || !finite_number(pitch) ||
+      pitch->valuedouble < -90 || pitch->valuedouble > 90 ||
+      (get(p, "fov") && !integer(get(p, "fov"), 30, 120, field)))
+    return error("INVALID_ARGUMENT", "invalid camera angles/FOV");
+  thirdperson = 0;
+  disablezoom();
+  player->roll = 0;
+  player->o = vec(pos[0], pos[1], pos[2]);
+  player->yaw = float(y->valuedouble);
+  player->pitch = float(pitch->valuedouble);
+  player->resetinterp();
+  fov = field;
+  recomputecamera();
+  observe_view();
+  cJSON *r = token_json();
+  cJSON_AddStringToObject(r, "view_revision", decimal(view_revision).c_str());
+  return success(r);
+}
+static bool capture_pending = false;
+static std::string capture_epoch;
+static uint64_t capture_revision = 0, capture_view = 0;
+static cJSON *capture(const cJSON *p) {
+  if (!fields(p, "|map_epoch||expected_revision||view_revision|"))
+    return error("INVALID_ARGUMENT", "unknown capture fields");
+  if (str(p, "map_epoch") != map_epoch || str(p, "expected_revision") != decimal(revision) ||
+      str(p, "view_revision") != decimal(view_revision))
+    return error("STALE_STATE", "requested frame is no longer current");
+  if (minimized || mainmenu || !screen)
+    return error("CAPTURE_UNAVAILABLE", "no game frame can be drawn");
+  capture_pending = true;
+  capture_epoch = map_epoch;
+  capture_revision = revision;
+  capture_view = view_revision;
+  return NULL;
+}
