+}
+static cJSON *arr3(float x, float y, float z) {
+  double n[] = {x, y, z};
+  return cJSON_CreateDoubleArray(n, 3);
+}
+static bool ints3(const cJSON *v, int *out, int low, int high) {
+  if (!cJSON_IsArray(v) || cJSON_GetArraySize(v) != 3)
+    return false;
+  for (int i = 0; i < 3; i++)
+    if (!integer(cJSON_GetArrayItem(v, i), low, high, out[i]))
+      return false;
+  return true;
+}
+static bool floats3(const cJSON *v, float *out, float low, float high) {
+  if (!cJSON_IsArray(v) || cJSON_GetArraySize(v) != 3)
+    return false;
+  for (int i = 0; i < 3; i++) {
+    const cJSON *n = cJSON_GetArrayItem(v, i);
+    if (!finite_number(n) || n->valuedouble < low || n->valuedouble > high)
+      return false;
+    out[i] = float(n->valuedouble);
+  }
+  return true;
+}
