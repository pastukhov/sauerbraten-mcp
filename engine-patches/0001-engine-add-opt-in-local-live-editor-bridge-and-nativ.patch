diff --git a/.gitattributes b/.gitattributes
new file mode 100644
index 0000000..c519540
--- /dev/null
+++ b/.gitattributes
@@ -0,0 +1,2 @@
+# Keep audited third-party bytes identical to the cJSON release/checksums.
+src/vendor/cjson/* -whitespace
diff --git a/src/Makefile b/src/Makefile
index bb15b25..f064957 100644
--- a/src/Makefile
+++ b/src/Makefile
@@ -135,6 +135,30 @@ CLIENT_OBJS= \
 
 CLIENT_PCH= shared/cube.h.gch engine/engine.h.gch fpsgame/game.h.gch
 
+# The editor bridge is opt-in and currently uses Linux Unix-domain credentials.
+.DEFAULT_GOAL := default
+ifeq ($(MCP),1)
+ifneq ($(PLATFORM),LINUX)
+$(error MCP=1 currently requires Linux)
+endif
+MCP_OBJS=engine/mcpwire.o engine/mcpbridge.o engine/mcpstate.o engine/mcpeditor.o engine/mcpvalidate.o tests/mcp/runner_cases.o vendor/cjson/cJSON.o
+CLIENT_OBJS:=$(addprefix .mcp/,$(CLIENT_OBJS) $(MCP_OBJS))
+override CLIENT_LIBS += -lcrypto
+# Refresh pre-existing upstream PCH files after installing the guarded headers.
+# GCC then rejects their ENABLE_MCP=undefined state for enabled object recipes.
+$(CLIENT_OBJS): $(CLIENT_PCH)
+-include $(CLIENT_OBJS:.o=.d)
+endif
+
+# Distinct objects prevent stale default/MCP builds when switching the option.
+.mcp/%.o: %.cpp
+	@mkdir -p $(dir $@)
+	$(CXX) $(CXXFLAGS) -DENABLE_MCP -MMD -MP -c -o $@ $<
+
+.mcp/vendor/cjson/cJSON.o: vendor/cjson/cJSON.c vendor/cjson/cJSON.h
+	@mkdir -p $(dir $@)
+	$(CC) $(CFLAGS) -O2 -DCJSON_NESTING_LIMIT=16 -MMD -MP -c -o $@ $<
+
 ifneq (,$(findstring MINGW,$(PLATFORM)))
 SERVER_INCLUDES= -DSTANDALONE $(INCLUDES) -Iinclude
 SERVER_LIBS= -mwindows $(STD_LIBS) -L$(WINBIN) -L$(WINLIB) -lzlib1 -lenet -lws2_32 -lwinmm
@@ -168,6 +192,7 @@ default: all
 all: client server
 
 clean:
+	-$(RM) -r .mcp tests/mcp/test_wire
 	-$(RM) $(CLIENT_PCH) $(CLIENT_OBJS) $(SERVER_MASTER_OBJS) sauer_client sauer_server sauer_master
 
 $(filter-out shared/%,$(CLIENT_PCH)): $(filter shared/%,$(CLIENT_PCH))
@@ -543,3 +568,23 @@ fpsgame/server-standalone.o: fpsgame/aiman.h
 engine/master-standalone.o: shared/cube.h shared/tools.h shared/geom.h
 engine/master-standalone.o: shared/ents.h shared/command.h shared/iengine.h
 engine/master-standalone.o: shared/igame.h
+
+# Pure wire checks retain the actual production numeric optimization flags.
+tests/mcp/test_wire: tests/mcp/test_wire.cpp engine/mcpwire.cpp engine/mcpwire.h .mcp/vendor/cjson/cJSON.o
+	$(CXX) $(CXXFLAGS) -Iengine -o $@ tests/mcp/test_wire.cpp engine/mcpwire.cpp .mcp/vendor/cjson/cJSON.o
+
+.PHONY: test-mcp-transport test-mcp-build-modes
+test-mcp-transport: tests/mcp/test_wire
+	./tests/mcp/test_wire
+
+test-mcp-build-modes:
+	python3 tests/mcp/check_build_modes.py
+
+.PHONY: test-mcp
+ifeq ($(MCP),1)
+test-mcp: client test-mcp-transport test-mcp-build-modes
+	python3 tests/mcp/run_native_cases.py
+else
+test-mcp:
+	$(error test-mcp requires MCP=1; run make MCP=1 test-mcp)
+endif
