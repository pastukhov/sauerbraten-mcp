@@ -0,0 +1,72 @@
+#!/usr/bin/env python3
+"""Check optional build boundaries using make's dependency graph."""
+import os
+from pathlib import Path
+import subprocess
+import unittest
+
+SRC = Path(__file__).resolve().parents[2]
+
+
+def commands(*args):
+  # Do not inherit MCP=1 or the parent's jobserver/command-line overrides.
+  env = {k: v for k, v in os.environ.items()
+         if k not in ("MAKEFLAGS", "MFLAGS", "MAKEOVERRIDES", "MCP")}
+  return subprocess.run(["make", "-n", "-W", "engine/mcpbridge.cpp", *args], cwd=SRC, text=True, env=env,
+                        stdout=subprocess.PIPE, stderr=subprocess.PIPE)
+
+
+class BuildModes(unittest.TestCase):
+  def test_enabled_client_uses_separate_objects_and_crypto(self):
+    result = commands("MCP=1", "client")
+    self.assertEqual(result.returncode, 0, result.stderr)
+    self.assertIn(".mcp/engine/mcpbridge.o", result.stdout)
+    self.assertIn("-DENABLE_MCP", result.stdout)
+    self.assertIn("-lcrypto", result.stdout)
+
+  def test_default_goal_preserves_upstream_client_and_server(self):
+    result = commands()
+    self.assertEqual(result.returncode, 0, result.stderr)
+    self.assertIn("-o sauer_client", result.stdout)
+    self.assertIn("-o sauer_server", result.stdout)
+    self.assertNotIn("cJSON", result.stdout)
+    self.assertNotIn("-lcrypto", result.stdout)
+
+  def test_enabled_default_goal_builds_the_client(self):
+    result = commands("MCP=1")
+    self.assertEqual(result.returncode, 0, result.stderr)
+    self.assertIn("-o sauer_client", result.stdout)
+
+  def test_default_client_has_no_mcp_dependencies(self):
+    result = commands("client")
+    self.assertEqual(result.returncode, 0, result.stderr)
+    self.assertNotIn("mcpbridge.o", result.stdout)
+    self.assertNotIn("-lcrypto", result.stdout)
+    self.assertNotIn("-DENABLE_MCP", result.stdout)
+
+  def test_standalone_does_not_link_mcp(self):
+    result = commands("MCP=1", "server", "master")
+    self.assertEqual(result.returncode, 0, result.stderr)
+    self.assertNotIn("mcpbridge.o", result.stdout)
+    self.assertNotIn("-lcrypto", result.stdout)
+    self.assertNotIn("-DENABLE_MCP", result.stdout)
+
+  def test_full_suite_requires_enabled_build(self):
+    result = commands("test-mcp")
+    self.assertNotEqual(result.returncode, 0)
+    self.assertIn("test-mcp requires MCP=1", result.stderr)
+
+  def test_full_suite_builds_enabled_client_first(self):
+    result = commands("MCP=1", "test-mcp")
+    self.assertEqual(result.returncode, 0, result.stderr)
+    self.assertIn("-o sauer_client", result.stdout)
+    self.assertIn("run_native_cases.py", result.stdout)
+
+  def test_unsupported_mcp_platform_fails_clearly(self):
+    result = commands("MCP=1", "PLATFORM=DARWIN", "client")
+    self.assertNotEqual(result.returncode, 0)
+    self.assertIn("MCP=1 currently requires Linux", result.stderr)
+
+
+if __name__ == "__main__":
+  unittest.main()
