+}
+struct Bounds {
+  int o[3], e[3];
+};
+static bool bounds(const cJSON *p, Bounds &b) {
+  return fields(p, "|origin||extent|") && ints3(get(p, "origin"), b.o, 0, worldsize - 1) &&
+         ints3(get(p, "extent"), b.e, 1, worldsize) &&
+         uint64_t(b.o[0]) + b.e[0] <= uint64_t(worldsize) &&
+         uint64_t(b.o[1]) + b.e[1] <= uint64_t(worldsize) &&
+         uint64_t(b.o[2]) + b.e[2] <= uint64_t(worldsize);
+}
+struct Node {
+  ivec o;
+  int size;
+  Node(const ivec &o, int size) : o(o), size(size) {}
+};
+struct RegionCursor {
+  std::vector<Node> stack;
+  Bounds bounds;
+  uint64_t rev;
+  std::string epoch;
+};
+static std::map<std::string, RegionCursor> cursors;
+static bool overlap(const Node &n, const Bounds &b) {
+  for (int i = 0; i < 3; i++)
+    if (n.o[i] >= b.o[i] + b.e[i] || n.o[i] + n.size <= b.o[i])
+      return false;
+  return true;
+}
+static cJSON *region(const cJSON *p) {
+  if (!fields(p, "|bounds||cursor|"))
+    return error("INVALID_ARGUMENT", "unknown region fields");
+  Bounds b;
+  if (!bounds(get(p, "bounds"), b))
+    return error("INVALID_ARGUMENT", "invalid half-open bounds");
+  RegionCursor cur;
+  std::string id = str(p, "cursor");
+  if (!id.empty()) {
+    std::map<std::string, RegionCursor>::iterator it = cursors.find(id);
+    if (it == cursors.end() || it->second.rev != revision || it->second.epoch != map_epoch ||
+        memcmp(&it->second.bounds, &b, sizeof(b)))
+      return error("STALE_STATE", "cursor no longer valid");
+    cur = it->second;
+    cursors.erase(it);
+  } else {
+    cur.bounds = b;
+    cur.rev = revision;
+    cur.epoch = map_epoch;
+    for (int i = 7; i >= 0; i--)
+      cur.stack.push_back(Node(ivec(i, ivec(0, 0, 0), worldsize / 2), worldsize / 2));
+  }
+  cJSON *r = token_json(), *leaves = cJSON_AddArrayToObject(r, "leaves");
+  int visited = 0, count = 0;
+  while (!cur.stack.empty() && visited < 4096 && count < 256) {
+    Node n = cur.stack.back();
+    cur.stack.pop_back();
+    visited++;
+    if (!overlap(n, b))
+      continue;
+    cube &c = lookupcube(n.o, -n.size);
+    if (c.children) {
+      for (int i = 7; i >= 0; i--)
+        cur.stack.push_back(Node(ivec(i, n.o, n.size / 2), n.size / 2));
+      continue;
+    }
+    cJSON *l = cJSON_CreateObject();
+    cJSON_AddItemToObject(l, "origin", arr3(n.o.x, n.o.y, n.o.z));
+    cJSON_AddNumberToObject(l, "size", n.size);
+    cJSON_AddNumberToObject(l, "material", c.material);
+    cJSON *e = cJSON_AddArrayToObject(l, "edges");
+    for (int i = 0; i < 12; i++)
+      cJSON_AddItemToArray(e, cJSON_CreateNumber(c.edges[i]));
+    cJSON *t = cJSON_AddArrayToObject(l, "textures");
+    for (int i = 0; i < 6; i++)
+      cJSON_AddItemToArray(t, texture_ref(c.texture[i]));
+    cJSON_AddItemToArray(leaves, l);
+    count++;
+  }
+  cJSON_AddNumberToObject(r, "visited_nodes", visited);
+  if (!cur.stack.empty()) {
+    if (cursors.size() >= 64)
+      cursors.erase(cursors.begin());
+    id = uuid();
+    cursors[id] = cur;
+    cJSON_AddStringToObject(r, "next_cursor", id.c_str());
+  } else
+    cJSON_AddNullToObject(r, "next_cursor");
+  return success(r);
+}
+static cJSON *catalog(const cJSON *p, bool models) {
+  if (!fields(p, "|offset||limit||map_epoch||generation|"))
+    return error("INVALID_ARGUMENT", "unknown catalog fields");
+  int offset = 0, limit = 256;
+  if (get(p, "offset") && !integer(get(p, "offset"), 0, 1000000, offset))
+    return error("INVALID_ARGUMENT", "invalid offset");
+  if (get(p, "limit") && !integer(get(p, "limit"), 1, 256, limit))
+    return error("INVALID_ARGUMENT", "invalid limit");
+  uint64_t generation = models ? mapmodel_generation : vslot_generation;
+  if (offset && (str(p, "map_epoch") != map_epoch || str(p, "generation") != decimal(generation)))
+    return error("STALE_STATE", "catalog changed");
+  cJSON *r = token_json(), *entries = cJSON_AddArrayToObject(r, "entries");
+  cJSON_AddStringToObject(r, "generation", decimal(generation).c_str());
+  int total = models ? mapmodels.length() : vslots.length();
+  int end = min(offset + limit, total);
+  for (int i = offset; i < end; i++) {
+    cJSON *e = cJSON_CreateObject();
+    cJSON_AddItemToObject(e, "ref", models ? model_ref(i) : texture_ref(i));
+    const char *name = "";
+    if (models)
+      name = mapmodels[i].name;
+    else {
+      VSlot *vs = vslots[i];
+      if (vs->slot && !vs->slot->sts.empty())
+        name = vs->slot->sts[0].name;
+    }
+    cJSON_AddStringToObject(e, "name", name);
+    cJSON_AddItemToArray(entries, e);
+  }
+  if (end < total)
+    cJSON_AddNumberToObject(r, "next_offset", end);
+  else
+    cJSON_AddNullToObject(r, "next_offset");
+  return success(r);
+}
+static cJSON *entity_list(const cJSON *p) {
+  if (!fields(p, "|bounds||type||offset||limit||map_epoch||revision|"))
+    return error("INVALID_ARGUMENT", "unknown entity fields");
+  Bounds b;
+  bool filtered = get(p, "bounds");
+  if (filtered && !bounds(get(p, "bounds"), b))
+    return error("INVALID_ARGUMENT", "invalid bounds");
+  int offset = 0, limit = 256;
+  if (get(p, "offset") && !integer(get(p, "offset"), 0, MAXENTS, offset))
+    return error("INVALID_ARGUMENT", "invalid offset");
+  if (get(p, "limit") && !integer(get(p, "limit"), 1, 256, limit))
+    return error("INVALID_ARGUMENT", "invalid limit");
+  if (offset && (str(p, "map_epoch") != map_epoch || str(p, "revision") != decimal(revision)))
+    return error("STALE_STATE", "entity list changed");
+  cJSON *r = token_json(), *out = cJSON_AddArrayToObject(r, "entries");
+  const vector<extentity *> &ents = entities::getents();
+  int count = 0, i = offset;
+  std::string type = str(p, "type");
+  for (; i < ents.length() && count < limit; i++) {
+    const extentity &e = *ents[i];
+    if (e.type == ET_EMPTY)
+      continue;
+    const char *name = entities::entname(e.type);
+    if (!type.empty() && type != name)
+      continue;
+    if (filtered) {
+      bool inside = true;
+      for (int d = 0; d < 3; d++)
+        if (e.o[d] < b.o[d] || e.o[d] >= b.o[d] + b.e[d])
+          inside = false;
+      if (!inside)
+        continue;
+    }
+    cJSON *j = cJSON_CreateObject();
+    cJSON_AddItemToObject(j, "ref", entity_ref(i));
+    cJSON_AddStringToObject(j, "type", name);
+    cJSON_AddItemToObject(j, "position", arr3(e.o.x, e.o.y, e.o.z));
+    int attrs[] = {e.attr1, e.attr2, e.attr3, e.attr4, e.attr5};
+    cJSON_AddItemToObject(j, "attrs", cJSON_CreateIntArray(attrs, 5));
+    cJSON_AddItemToArray(out, j);
+    count++;
+  }
+  if (i < ents.length())
+    cJSON_AddNumberToObject(r, "next_offset", i);
+  else
+    cJSON_AddNullToObject(r, "next_offset");
+  return success(r);
+}
+
+static bool uuid_valid(const std::string &s) {
+  if (s.size() != 36)
+    return false;
+  for (size_t i = 0; i < s.size(); i++) {
+    if (i == 8 || i == 13 || i == 18 || i == 23) {
+      if (s[i] != '-')
+        return false;
+    } else if (!((s[i] >= '0' && s[i] <= '9') || (s[i] >= 'a' && s[i] <= 'f')))
+      return false;
+  }
+  return true;
+}
+struct Completed {
+  std::string key, reply, public_input_hash;
+};
+static std::map<std::string, Completed> completed;
+static std::vector<std::string> completion_order;
+static cJSON *mutation_guard(const cJSON *p, bool lifecycle = false) {
+  if (!uuid_valid(str(p, "request_id")))
+    return error("INVALID_ARGUMENT", "request_id must be a UUID");
+  if (str(p, "map_epoch") != map_epoch || str(p, "expected_revision") != decimal(revision))
+    return error("STALE_STATE", "map changed; read state before editing");
+  if (!editmode && !(lifecycle && recovery_required))
+    return error("NOT_EDITING", "enter edit mode first");
+  if (multiplayer(false) || isconnected(true, false) || game::demoplayback)
+    return error("MULTIPLAYER_UNSUPPORTED", "only local single-player editing is supported");
+  if (mcp_editor_busy())
+    return error("BUSY", "finish the current editor drag");
+  if (recovery_required && !lifecycle)
+    return error("MAP_LOAD_FAILED", "recover the map before editing");
+  return NULL;
+}
+static bool selection(const cJSON *p, selinfo &s) {
+  int o[3], count[3], grid = 0, orient = 0;
+  if (!fields(p, "|origin||count||grid||orient|") ||
+      !ints3(get(p, "origin"), o, 0, worldsize - 1) || !ints3(get(p, "count"), count, 1, 4096) ||
+      !integer(get(p, "grid"), 1, worldsize / 2, grid) ||
+      !integer(get(p, "orient"), 0, 5, orient) || (grid & (grid - 1)))
+    return false;
+  uint64_t cells = 1;
+  for (int i = 0; i < 3; i++) {
+    if (o[i] % grid || uint64_t(o[i]) + uint64_t(count[i]) * grid > uint64_t(worldsize))
+      return false;
+    cells *= count[i];
+    if (cells > 4096)
+      return false;
+  }
+  s.o = ivec(o[0], o[1], o[2]);
+  s.s = ivec(count[0], count[1], count[2]);
+  s.grid = grid;
+  s.orient = orient;
+  s.cx = s.cy = 0;
+  s.cxs = count[R[dimension(orient)]] * 2;
+  s.cys = count[C[dimension(orient)]] * 2;
+  return true;
+}
+static bool check_texture(const cJSON *r, int &index) {
+  return fields(r, "|map_epoch||vslot_generation||index|") && str(r, "map_epoch") == map_epoch &&
+         str(r, "vslot_generation") == decimal(vslot_generation) &&
+         integer(get(r, "index"), 0, vslots.length() - 1, index);
+}
+static cJSON *mutation_result(const cJSON *p) {
+  cJSON *r = token_json();
+  cJSON_AddStringToObject(r, "operation_id", str(p, "request_id").c_str());
+  return success(r);
+}
+static cJSON *geometry(const std::string &method, const cJSON *p) {
+  const char *allowed =
+      method == "geometry_fill"
+          ? "|request_id||map_epoch||expected_revision||selection||mode||texture_ref|"
+      : method == "texture_apply"
+          ? "|request_id||map_epoch||expected_revision||selection||texture_ref||faces|"
+          : "|request_id||map_epoch||expected_revision||selection||material|";
+  if (!fields(p, allowed))
+    return error("INVALID_ARGUMENT", "unknown mutation fields");
+  selinfo s;
+  if (!selection(get(p, "selection"), s))
+    return error("INVALID_ARGUMENT", "invalid aligned selection or cell budget exceeded");
+  int op = 0, texture = DEFAULT_GEOM, face = -1, material = MAT_AIR;
+  if (method == "geometry_fill") {
+    std::string mode = str(p, "mode");
+    if (mode == "empty")
+      op = 1;
+    else if (mode == "solid")
+      op = 0;
+    else
+      return error("INVALID_ARGUMENT", "mode must be solid or empty");
+    if (op == 0 && !check_texture(get(p, "texture_ref"), texture))
+      return error("STALE_STATE", "invalid or expired texture ref");
+  } else if (method == "texture_apply") {
+    op = 2;
+    if (!check_texture(get(p, "texture_ref"), texture))
+      return error("STALE_STATE", "invalid or expired texture ref");
+    const cJSON *f = get(p, "faces");
+    if (!(cJSON_IsString(f) && !strcmp(f->valuestring, "all")) && !integer(f, 0, 5, face))
+      return error("INVALID_ARGUMENT", "faces must be all or orientation 0..5");
+  } else {
+    op = 3;
+    std::string name = str(p, "material");
+    const char *names[] = {"air", "water", "lava", "glass", "clip", "noclip", "gameclip", "death"};
+    int values[] = {MAT_AIR,  MAT_WATER,  MAT_LAVA,     MAT_GLASS,
+                    MAT_CLIP, MAT_NOCLIP, MAT_GAMECLIP, MAT_DEATH};
+    bool found = false;
+    for (int i = 0; i < 8; i++)
+      if (name == names[i]) {
+        found = true;
+        material = values[i];
+      }
+    if (!found)
+      return error("INVALID_ARGUMENT", "unsupported material");
+  }
+  const char *err = mcp_geometry(s, op, texture, face, material);
+  return err ? error(err, "edit was not applied") : mutation_result(p);
+}
+
+static cJSON *entity_edit(const std::string &method, const cJSON *p) {
+  const char *allowed =
+      method == "entity_create"
+          ? "|request_id||map_epoch||expected_revision||type||position||attrs||model_ref|"
+      : method == "entity_update"
+          ? "|request_id||map_epoch||expected_revision||entity_ref||position||attrs||model_ref|"
+          : "|request_id||map_epoch||expected_revision||entity_ref|";
+  if (!fields(p, allowed))
+    return error("INVALID_ARGUMENT", "unknown entity fields");
+  bool create = method == "entity_create", remove = method == "entity_delete";
+  int index = -1;
+  entity e;
+  memset(&e, 0, sizeof(e));
+  if (!create) {
+    const cJSON *ref = get(p, "entity_ref");
+    if (!fields(ref, "|map_epoch||index||generation|") || str(ref, "map_epoch") != map_epoch ||
+        !integer(get(ref, "index"), 0, MAXENTS - 1, index) ||
+        str(ref, "generation") != decimal(entity_generation(index)) ||
+        !entities::getents().inrange(index) || entities::getents()[index]->type == ET_EMPTY)
+      return error("STALE_STATE", "entity ref no longer valid");
+    e = *entities::getents()[index];
+  }
+  if (remove)
+    e.type = ET_EMPTY;
+  else {
+    int type = e.type;
+    if (create) {
+      std::string t = str(p, "type");
+      if (t == "light")
+        type = ET_LIGHT;
+      else if (t == "playerstart")
+        type = ET_PLAYERSTART;
+      else if (t == "mapmodel")
+        type = ET_MAPMODEL;
+      else
+        return error("INVALID_ARGUMENT", "unsupported entity type");
+    }
+    if (type != ET_LIGHT && type != ET_PLAYERSTART && type != ET_MAPMODEL)
+      return error("UNSUPPORTED_ENTITY_ATTRIBUTES", "entity type not editable in this release");
+    float pos[3];
+    if (!floats3(get(p, "position"), pos, 0, float(worldsize)))
+      return error("INVALID_ARGUMENT", "invalid position");
+    for (int i = 0; i < 3; i++)
+      if (pos[i] >= worldsize)
+        return error("INVALID_ARGUMENT", "position outside world");
+    const cJSON *a = get(p, "attrs");
+    if (!cJSON_IsArray(a) || cJSON_GetArraySize(a) != 5)
+      return error("INVALID_ARGUMENT", "exactly five attrs required");
+    int attr[5];
+    for (int i = 0; i < 5; i++)
+      if (!integer(cJSON_GetArrayItem(a, i), 0, 32767, attr[i]))
+        return error("INVALID_ARGUMENT", "invalid attr");
+    if (attr[4] || (type == ET_LIGHT && (attr[1] > 255 || attr[2] > 255 || attr[3] > 255)) ||
+        (type == ET_PLAYERSTART && (attr[0] > 359 || attr[1] > 2 || attr[2] || attr[3])) ||
+        (type == ET_MAPMODEL && (attr[0] > 359 || attr[2] || attr[3])))
+      return error("UNSUPPORTED_ENTITY_ATTRIBUTES", "attrs outside supported entity schema");
+    if (type == ET_MAPMODEL) {
+      const cJSON *ref = get(p, "model_ref");
+      int mi = -1;
+      if (!fields(ref, "|map_epoch||mapmodel_generation||index|") ||
+          str(ref, "map_epoch") != map_epoch ||
+          str(ref, "mapmodel_generation") != decimal(mapmodel_generation) ||
+          !integer(get(ref, "index"), 0, mapmodels.length() - 1, mi) || attr[1] != mi)
+        return error("STALE_STATE", "model ref no longer valid");
+    }
+    e.type = type;
+    e.o = vec(pos[0], pos[1], pos[2]);
+    e.attr1 = attr[0];
+    e.attr2 = attr[1];
+    e.attr3 = attr[2];
+    e.attr4 = attr[3];
+    e.attr5 = attr[4];
+  }
+  const char *err = mcp_entity(index, e, create);
+  if (err)
+    return error(err, "entity was not changed");
+  cJSON *r = token_json();
+  cJSON_AddStringToObject(r, "operation_id", str(p, "request_id").c_str());
+  if (!remove)
+    cJSON_AddItemToObject(r, "entity_ref", entity_ref(index));
+  return success(r);
+}
